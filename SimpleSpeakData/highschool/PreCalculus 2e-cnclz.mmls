<mrow> <mi>x</mi> <mo>⁢</mo> <mrow> <mo>(</mo> <mrow> <mrow> <mi>ln</mi> <mo>⁡</mo> <mn>5</mn> </mrow> <mo>-</mo> <mrow> <mi>ln</mi> <mo>⁡</mo> <mn>4</mn> </mrow> </mrow> <mo>)</mo> </mrow> </mrow> <mo>=</mo> <mrow> <mrow> <mo>-</mo> <mn>2</mn> </mrow> <mo>⁢</mo> <mrow> <mi>ln</mi> <mo>⁡</mo> <mn>5</mn> </mrow> </mrow> </mrow> </mtd> <mtd> <mrow> <mrow> <mtext>On the left hand side, factor out an</mtext> <mo>⁢</mo> <mi>x</mi> </mrow> <mo>.</mo> </mrow> </mtd> </mtr> <mtr> <mtd> <mrow> <mrow> <mi>x</mi> <mo>⁢</mo> <mrow> <mi>ln</mi> <mo>⁡</mo> <mrow> <mo>(</mo> <mfrac> <mn>5</mn> <mn>4</mn> </mfrac> <mo>)</mo> </mrow> </mrow> </mrow> <mo>=</mo> <mrow> <mrow> <mi>ln</mi> <mo>⁡</mo> <mrow> <mo>(</mo> <mfrac> <mn>1</mn> <mn>25</mn> </mfrac> <mo>)</mo> </mrow> </mrow> <mo>⁢</mo> <mtable> <mtr> <mtd> <mtext> </mtext> </mtd> <mtd> <mtext> </mtext> </mtd> <mtd> <mtext> </mtext> </mtd> <mtd> <mtext> </mtext> </mtd> </mtr> </mtable> </mrow> </mrow> </mtd> <mtd> <mtext>Use the laws of logs.</mtext> </mtd> </mtr> <mtr> <mtd> <mrow> <mi>x</mi> <mo>=</mo> <mfrac> <mrow> <mi>ln</mi> <mo>⁡</mo> <mrow> <mo>(</mo> <mfrac> <mn>1</mn> <mn>25</mn> </mfrac> <mo>)</mo> </mrow> </mrow> <mrow> <mi>ln</mi> <mo>⁡</mo> <mrow> <mo>(</mo> <mfrac> <mn>5</mn> <mn>4</mn> </mfrac> <mo>)</mo> </mrow> </mrow> </mfrac> </mrow> </mtd> <mtd> <mrow> <mrow> <mtext>Divide by the coefficient of</mtext> <mo>⁢</mo> <mi>x</mi> </mrow> <mo>.</mo> </mrow> </mtd> </mtr> </mtable> </math>
