<math><mtable displaystyle="true" columnspacing="1em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>S</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>r</mi><mspace width="0.167em"></mspace><mi>r</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>π</mi></mrow></msubsup><mi mathvariant="normal">d</mi><mi>θ</mi><mtext> </mtext><msup><mi>r</mi><mn>2</mn></msup><mo>=</mo><mn>2</mn><mi>π</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>r</mi><mspace width="0.167em"></mspace><msup><mi>r</mi><mn>3</mn></msup><mo>=</mo><mn>2</mn><mi>π</mi><mfrac><mn>1</mn><mn>4</mn></mfrac><mo>=</mo><mfrac><mi>π</mi><mn>2</mn></mfrac></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnspacing="1em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>⋅</mo><mi mathvariant="bold">F</mi><mo>=</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>tan</mi><mo data-mjx-texclass="NONE">⁡</mo><msqrt><mi>z</mi></msqrt><mo>+</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><msup><mi>y</mi><mn>3</mn></msup><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>+</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></msup><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>+</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>=</mo><mn>1</mn></mrow></mtd></mtr></mtable></math>
