<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>S</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∭</mo><mi>V</mi></msub><mn>2</mn><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>V</mi><mo>−</mo><msub><mo data-mjx-texclass="OP">∬</mo><mrow data-mjx-texclass="ORD"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup><mo>≤</mo><mn>4</mn></mrow></msub><mspace width="-5pt"></mspace><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><mi>z</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>z</mi><mo>−</mo><msub><mo data-mjx-texclass="OP">∬</mo><mrow data-mjx-texclass="ORD"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup><mo>≤</mo><mn>4</mn></mrow></msub><mspace width="-5pt"></mspace><mo stretchy="false">(</mo><mo>−</mo><mi>x</mi><mo>−</mo><mi>z</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∭</mo><mi>V</mi></msub><mn>2</mn><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>V</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>2</mn><mtext> </mtext><mtext>volume</mtext><mo stretchy="false">(</mo><mi>V</mi><mo stretchy="false">)</mo><mo>=</mo><mn>2</mn><mo stretchy="false">(</mo><mi>π</mi><msup><mn>2</mn><mn>2</mn></msup><mo stretchy="false">)</mo><mn>3</mn><mo>=</mo><mn>24</mn><mi>π</mi></mrow></mtd></mtr></mtable></math