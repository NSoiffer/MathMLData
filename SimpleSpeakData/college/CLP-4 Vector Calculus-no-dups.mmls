<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><mi>x</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>∂</mi><mi>y</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>∂</mi><mi>z</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo stretchy="false">(</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>,</mo><mn>2</mn><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><mi>x</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>∂</mi><mi>y</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>∂</mi><mi>z</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>±</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><mi>x</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>∂</mi><mi>y</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac><mo>,</mo><mfrac><mrow><mi>∂</mi><mi>z</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mo>×</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><mi>x</mi></