<math><mrow><mi>y</mi><mo>=</mo><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mi>x</mi><mi>z</mi></mrow></msup><mo>=</mo><msup><mi>e</mi><msup><mi>x</mi><mn>2</mn></msup></msup><mtext>.</mtext></mrow></math>
<math><mrow><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>=</mo><mi>x</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><msup><mi>e</mi><msup><mi>x</mi><mn>2</mn></msup></msup><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>x</mi><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mtext>,</mtext></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mo stretchy="false">(</mo><mi mathvariant="bold">F</mi><mo>−</mo><mi mathvariant="bold">G</mi><mo stretchy="false">)</mo><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>+</mo><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mi mathvariant="bold">G</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><mo minsize="1.623em" maxsize="1.623em">[</mo><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup><mo>−</mo><mi>x</mi><mi>y</mi><mi>z</mi><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><msubsup><mo minsize="1.623em" maxsize="1.623em">]</mo><mrow data-mjx-texclass="ORD"><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow data-mjx-texclass="ORD"><mo stretchy="false">(</mo><mn>1</mn><mo>,</mo><mi>e</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup><mo>+</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mover><mover><mrow><mo stretchy="false">[</mo><mi>x</mi><msup><mi>e</mi><msup><mi>x</mi><mn>2</mn></msup></msup><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>x</mi><msup><mi>e</mi><msup><mi>x</mi><mn>2</mn></msup></msup><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo stretchy="false">]</mo></mrow><mo>⏞</mo></mover><mrow data-mjx-texclass="ORD"><mi mathvariant="bold">G</mi><mo stretchy="false">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo></mrow></mover><mo>⋅</mo><mover><mover><mrow><mo stretchy="false">[</mo><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mn>2</mn><mi>x</mi><msup><mi>e</mi><msup><mi>x</mi><mn>2</mn></msup></msup><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo stretchy="false">]</mo></mrow><mo>⏞</mo></mover><mfrac><mrow><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mfrac></mover><mtext> </mtext><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><mi>e</mi><mo>+</mo><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn><mo>+</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mn>2</mn><mi>x</mi><msup><mi>e</mi><msup><mi>x</mi><mn>2</mn></msup></msup><mtext> </mtext><mi mathvariant="normal">d</mi><mi>x</mi><mo>=</mo><mi>e</mi><mo>+</mo><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn><mo>+</mo><mo minsize="1.623em" maxsize="1.623em">[</mo><msup><mi>e</mi><msup><mi>x</mi><mn>2</mn></msup></msup><msubsup><mo minsize="1.623em" maxsize="1.623em">]</mo><mn>0</mn><mn>1</mn></msubsup><mo>=</mo><msup><mi>e</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>e</mi><mo>−</mo><mn>2</mn></mrow></mtd></mtr></mtable></math>
<math><mrow><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>=</mo><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo><mo>+</mo><mi>t</mi><mo minsize="1.2em" maxsize="1.2em">{</mo><mo stretchy="false">(</mo><mn>2</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo><mo>−</mo><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">}</mo><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>2</mn><mi>t</mi><mo>,</mo><mi>t</mi><mo>,</mo><mn>1</mn><mo>−</mo><mi>t</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="2em"></mspace><mn>0</mn><mo>≤</mo><mi>t</mi><mo>≤</mo><mn>1</mn></mrow></math>
