<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>−</mo><mi>P</mi><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mi>x</mi><mo>+</mo><mfrac><mrow><mi mathvariant="normal">d</mi><mi>x</mi></mrow><mn>2</mn></mfrac><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo data-mjx-texclass="CLOSE">)</mo></mrow><mspace width="0.167em"></mspace><mi>d</mi><mi>y</mi><mi mathvariant="normal">d</mi><mi>z</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>P</mi><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mi>x</mi><mo>−</mo><mfrac><mrow><mi mathvariant="normal">d</mi><mi>x</mi></mrow><mn>2</mn></mfrac><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo data-mjx-texclass="CLOSE">)</mo></mrow><mspace width="0.167em"></mspace><mi>d</mi><mi>y</mi><mi mathvariant="normal">d</mi><mi>z</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="1in"></mspace><mo>=</mo><mo>−</mo><mfrac><mrow><mi>P</mi><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><mfrac><mrow><mi mathvariant="normal">d</mi><mi>x</mi></mrow><mn>2</mn></mfrac><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>−</mo><mi>P</mi><mo stretchy="false">(</mo><mi>x</mi><mo>−</mo><mfrac><mrow><mi mathvariant="normal">d</mi><mi>x</mi></mrow><mn>2</mn></mfrac><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow><mrow><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mfrac><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mtext> </mtext><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>y<