<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><msub><mo data-mjx-texclass="OP">∬</mo><mi>S</mi></msub><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi mathvariant="bold">F</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∮</mo><mi>C</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∮</mo><mi>C</mi></msub><mo stretchy="false">[</mo><mo>−</mo><mi>y</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><msup><mi>x</mi><mn>3</mn></msup><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo stretchy="false">]</mo><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.5in"></mspace><mo>=</mo><munder><munder><mrow><msubsup><mo data-mjx-texclass="OP">∫</mo><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn></mrow><mn>1</mn></msubsup><mo>−</mo><mo stretchy="false">(</mo><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi></mrow><mo>⏟</mo></munder><mrow data-mjx-texclass="ORD"><mi>y</mi><mo>=</mo><mo>−</mo><mn>1</mn><mrow data-mjx-texclass="ORD"><mtext> </mtext><mi mathvariant="normal">s</mi><mi mathvariant="normal">i</mi><mi mathvariant="normal">d</mi><mi mathvariant="normal">e</mi></mrow></mrow></munder><mo>+</mo><munder><munder><mrow><msubsup><mo data-mjx-texclass="OP">∫</mo><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn></mrow><mn>1