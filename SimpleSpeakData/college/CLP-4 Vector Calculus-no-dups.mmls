<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi>φ</mi></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msup><mi>y</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>+</mo><mn>2</mn><mi>x</mi><msup><mi>y</mi><mn>3</mn></msup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="1in"></mspace><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mi>x</mi><msup><mi>y</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><msup><mi>y</mi><mn>3</mn></msup><mo>+</mo><msub><mi>ψ</mi><mn>1</mn></msub><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi>φ</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>2</mn><mi>x</mi><mi>y</mi><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>+</mo><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup><msup><mi>y</mi><mn>2</mn></msup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="1in"></mspace><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mi>x</mi><msup><mi>y</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texcla