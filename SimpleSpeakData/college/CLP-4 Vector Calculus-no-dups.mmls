<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><msub><mo data-mjx-texclass="OP">∬</mo><mrow data-mjx-texclass="ORD"><mi>∂</mi><mi>V</mi></mrow></msub><mi mathvariant="bold">G</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∬</mo><mtext>side</mtext></msub><mi mathvariant="bold">G</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mi>a</mi><mi>b</mi></msubsup><mi mathvariant="normal">d</mi><mi>t</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>z</mi><mtext> </mtext><mi mathvariant="bold">G</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">R</mi><mo stretchy="false">(</mo><mi>t</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>⋅</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mo>−</mo><msup><mi>x</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><msup><mi>y</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><