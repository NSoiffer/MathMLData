<math><mrow><mover><mi mathvariant="bold">B</mi><mo stretchy="false">^</mo></mover><mo>=</mo><mfrac><mrow><mi mathvariant="bold">v</mi><mo>×</mo><mi mathvariant="bold">a</mi></mrow><mrow><mo stretchy="false">|</mo><mi mathvariant="bold">v</mi><mo>×</mo><mi mathvariant="bold">a</mi><mo stretchy="false">|</mo></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><msqrt><mn>26</mn></msqrt></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mo>−</mo><msqrt><mn>2</mn></msqrt><mo>,</mo><mn>2</mn><msqrt><mn>2</mn></msqrt><mo>,</mo><mn>4</mn><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>=</mo><mfrac><mn>1</mn><msqrt><mn>13</mn></msqrt></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mo>−</mo><mn>1</mn><mo>,</mo><mn>2</mn><mo>,</mo><mn>2</mn><msqrt><mn>2</mn></msqrt><mo minsize="1.2em" maxsize="1.2em">)</mo><mtext>,</mtext></mrow></math>
