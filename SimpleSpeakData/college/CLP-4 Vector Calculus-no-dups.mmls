<math><mrow><mfrac><mi mathvariant="bold">r</mi><mi>r</mi></mfrac><mo>=</mo><mfrac><mrow><mi>x</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>y</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>z</mi><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow><mrow><mo stretchy="false">[</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup><msup><mo stretchy="false">]</mo><mrow data-mjx-texclass="ORD"><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow></mfrac><mtext>.</mtext></mrow></math>
