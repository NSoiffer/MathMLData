<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>S</mi></msub><msup><mi>y</mi><mn>3</mn></msup><mtext> </mtext><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>π</mi></mrow></msubsup><mi mathvariant="normal">d</mi><mi>θ</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>r</mi><mtext> </mtext><mi>r</mi><mo stretchy="false">(</mo><mn>2</mn><mo>−</mo><msup><mi>r</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mtext> </mtext><mo stretchy="false">(</mo><mn>2</mn><mi>π</mi><mo stretchy="false">)</mo><mtext> </mtext><msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><msup><mi>r</mi><mn>2</mn></msup><mo>−</mo><mfrac><msup><mi>r</mi><mn>4</mn></msup><mn>4</mn></mfrac><mo data-mjx-texclass="CLOSE">]</mo></mrow><mn>0</mn><mn>1</mn></msubsup><mo>=</mo><msqrt><mn>2</mn></msqrt><mtext> </mtext><mo stretchy="false">(</mo><mn>2</mn><mi>π</mi><mo stretchy="false">)</mo><mtext> </mtext><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mfrac><mn>3</mn><mn>4</mn></mfrac><mo data-mjx-texclass="CLOSE">]</mo></mrow><mo>=</mo><mfrac><mn>3</mn><msqrt><mn>2</mn></msqrt></mfrac><mi>π</mi></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><msub><mo data-mjx-texclass="OP">∬</mo><mi>S</mi></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>x</mi><mi>y</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>x</mi><mi>z</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>z</mi><mi>y</mi><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><msub><mo data-mjx-texclass="OP">∬</mo><mrow data-mjx-texclass="ORD"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup><mo>≤</mo><mn>1</mn></mrow></msub><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>z</mi><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>x</mi><msqrt><mn>2</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup></msqrt><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mi>x</mi><mi>z</mi><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mi>z</mi><msqrt><mn>2</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup></msqrt><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>⋅</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="2.5in"></mspace><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mfrac><mi>x</mi><msqrt><mn>2</mn><mo>−</mo><msup><mi>x</mi