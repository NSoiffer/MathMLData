<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∭</mo><mi>V</mi></msub><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>⋅</mo><mi mathvariant="bold">F</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>V</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∭</mo><mi>V</mi></msub><mo minsize="1.2em" maxsize="1.2em">[</mo><mi>z</mi><mo>+</mo><mn>1</mn><mo>+</mo><mi>z</mi><mo>−</mo><mn>2</mn><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">]</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>V</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∭</mo><mi>V</mi></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>V</mi><mo>=</mo><mfrac><mn>1</mn><mn>8</mn></mfrac><mtext> </mtext><mfrac><mn>4</mn><mn>3</mn></mfrac><mi>π</mi><msup><mi>a</mi><mn>3</mn></msup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>6</mn></mfrac><mi>π</mi><msup><mi>a</mi><mn>3</mn></msup></mrow></mtd></mtr><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mfrac linethickness="0pt"><mrow><mi>z</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi mathvariant="normal">f</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">e</mi></mrow></mfrac></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mo stretchy="false">(</mo><mo>−</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∬</mo><mfrac linethickness="0pt"><mrow><mi>z</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi mathvariant="normal">f</m