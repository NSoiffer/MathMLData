<math><mrow><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>ℓ</mi></msub><mo>×</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>m</mi></msub><mo>×</mo><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>n</mi></msub><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>=</mo><mo stretchy="false">(</mo><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>ℓ</mi></msub><mo>⋅</mo><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>n</mi></msub><mo stretchy="false">)</mo><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>m</mi></msub><mo>−</mo><mo stretchy="false">(</mo><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>ℓ</mi></msub><mo>⋅</mo><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>m</mi></msub><mo stretchy="false">)</mo><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>n</mi></msub><mo>=</mo><msub><mi>δ</mi><mrow data-mjx-texclass="ORD"><mi>ℓ</mi><mo>,</mo><mi>n</mi></mrow></msub><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>m</mi></msub><mo>−</mo><msub><mi>δ</mi><mrow data-mjx-texclass="ORD"><mi>ℓ</mi><mo>,</mo><mi>m</mi></mrow></msub><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>n</mi></msub></mrow></math>
