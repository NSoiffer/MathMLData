<math><mrow><msub><mi>S</mi><mn>2</mn></msub><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">{</mo><mtext> </mtext><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">|</mo><mtext> </mtext><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>≤</mo><mn>1</mn><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">}</mo></mrow></math>
