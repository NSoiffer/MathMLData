<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><msub><mi>S</mi><mn>1</mn></msub></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">{</mo><mtext> </mtext><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">|</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>x</mi><mo>≤</mo><mi>a</mi><mo>,</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>y</mi><mo>≤</mo><mi>b</mi><mo>,</mo><mtext> </mtext><mi>z</mi><mo>=</mo><mi>c</mi><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">}</mo><mtext> </mtext><mtext>with outward normal </mtext><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mo>=</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd><msub><mi>S</mi><mn>2</mn></msub></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">{</mo><mtext> </mtext><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">|</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>x</mi><mo>≤</mo><mi>a</mi><mo>,</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>y</mi><mo>≤</mo><mi>b</mi><mo>,</mo><mtext> </mtext><mi>z</mi><mo>=</mo><mn>0</mn><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">}</mo><mtext> </mtext><mtext>with outward normal </mtext><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mo>=</mo><mo>−</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd><msub><mi>S</mi><mn>3</mn></msub></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">{</mo><mtext> </mtext><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mtext> </mtext><mo minsize="1.2em" maxsize