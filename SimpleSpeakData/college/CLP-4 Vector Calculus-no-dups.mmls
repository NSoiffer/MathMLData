<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mspace width="0.167em"></mspace><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mn>0</mn><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mspace width="0.167em"></mspace><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mspace width="0.167em"></mspace><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mn>1</mn><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mspace width="0.167em"></mspace><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac><mo>×</mo><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mspace width="0.167em"></mspace><mi>cos</mi><mo d