<math><mtable displaystyle="true" columnspacing="1em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo>=</mo><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mspace width="2em"></mspace><mtext>and</mtext><mspace width="2em"></mspace><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo>=</mo><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr></mtable></math>
