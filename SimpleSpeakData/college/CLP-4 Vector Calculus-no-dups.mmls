mo>∧</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msub><mi>G</mi><mn>1</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>+</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msub><mi>F</mi><mn>3</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>∧</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msub><mi>G</mi><mn>2</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>+</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msub><mi>F</mi><mn>3</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>∧</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msub><mi>G</mi><mn>3</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="0.5in"></mspace><mtext>(by linearity, i.e. by part (b) of the last Definition)</mtext></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mtext> </mtext><msub><mi>F</mi><mn>1</mn></msub><msub><mi>G</mi><mn>1</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>+</mo><msub><mi>F</mi><mn>1</mn></msub><msub><mi>G</mi><mn>2</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>+</mo><msub><mi>F</mi><mn>1</mn></msub><msub><mi>G</mi><mn>3</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.1in"></mspace><mo>+</mo><msub><mi>F</mi><mn>2</mn></msub><msub><mi>G</mi><mn>1</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>+</mo><msub><mi>F</mi><mn>2</mn></msub><msub><mi>G</mi><mn>2</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>+</mo><msub><mi>F</mi><mn>2</mn></msub><msub><mi>G</mi><mn>3</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.1in"></mspace><mo>+</mo><msub><mi>F</mi><mn>3</mn></msub><msub><mi>G</mi><mn>1</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>+</mo><msub><mi>F</mi><mn>3</mn></msub><msub><mi>G</mi><mn>2</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>+</mo><msub><mi>F</mi><mn>3</mn></msub><msub><mi>G</mi><mn>3</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msub><mi>F</mi><mn>1</mn></msub><msub><mi>G</mi><mn>2</mn></msub><mo>−</mo><msub><mi>F</mi><mn>2</mn></msub><msub><mi>G</mi><mn>1</mn></msub><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>∧</mo><mi mathvariant="normal">d</mi><mi>y</mi><mo>+</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msub><mi>F</mi><mn>3</mn></msub><msub><mi>G</mi><mn>1</mn></msub><mo>−</mo><msub><mi>F</mi><mn>1</mn></msub><msub><mi>G</mi><mn>3</mn></msub><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo>∧</mo><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.1in"></mspace><mo>+</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msub><mi>F</mi><mn>2</mn></msub><msub><mi>G</mi><mn>3</mn></msub><mo>−</mo><msub><mi>F</mi><mn>3</mn></msub><msub><mi>G</mi><mn>2</mn></msub><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>∧</mo><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr></mtable></math>
<math><mrow><mi mathvariant="normal">d</mi><mi>x</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>=</mo><mi mathvariant="normal">d</mi><mi>y</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>=</mo><mi mathvariant="normal">d</mi><mi>z</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo>=</mo><mn>0</mn></mrow></math>
<math><mrow><mi mathvariant="normal">d</mi><mi>x</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>=</mo><mo>−</mo><mi mathvariant="normal">d</mi><mi>y</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="2em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo>=</mo><mo>−</mo><mi mathvariant="normal">d</mi><mi>z</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="2em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>=</mo><mo>−</mo><mi mathvariant="normal">d</mi><mi>y</mi><mo>∧</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></math>
<math><mrow><mi mathvariant="bold">F</mi><mo>=</mo><mo stretchy="false">(</mo><msub><mi>F</mi><mn>1</mn></msub><mo>,</mo><msub><mi>F</mi><mn>2</mn></msub><mo>,</mo><msub><mi>F</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></math>
<math><mrow><mi mathvariant="bold">G</mi><mo>=</mo><mo stretchy="false">(</mo><msub><mi>G</mi><mn>1</mn></msub><mo>,</mo><msub><mi>G</mi><mn>2</mn></msub><mo>,</mo><msub><mi>G</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></math>
