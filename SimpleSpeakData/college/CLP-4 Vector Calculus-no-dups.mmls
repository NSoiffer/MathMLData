<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∫</mo><mi data-mjx-variant="-tex-calligraphic" mathvariant="script">C</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mn>2</mn></msubsup><mi mathvariant="bold">F</mi><mo stretchy="false">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>⋅</mo><msup><mi mathvariant="bold">r</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>t</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mn>2</mn></msubsup><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>8</mn><msup><mi>t</mi><mn>2</mn></msup><mo>−</mo><mn>32</mn><mo minsize="1.2em" maxsize="1.2em">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>t</mi><mo>=</mo><msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mfrac><mn>8</mn><mn>3</mn></mfrac><msup><mi>t</mi><mn>3</mn></msup><mo>−</mo><mn>32</mn><mi>t</mi><mo data-mjx-texclass="CLOSE">]</mo></mrow><mn>1</mn><mn>2</mn></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mfrac><mn>40</mn><mn>3</mn></mfrac></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi mathvariant="bold">F</mi><mo>=</mo><mo data-mjx-texclass="OP" movablelimits="true">det</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mtable columnalign="center" columnspacing="1em" rowspacing="4pt"><mtr><mtd><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mtd></mtr><mtr><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac></mtd><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac></mtd><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac></mtd></mtr><mtr><mtd><mrow><mn>6</mn><msup><mi>x</mi><mn>2</mn></msup><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup></mrow></mtd><mtd><mrow><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup><msup><mi>z</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>y</mi><mo>−</mo><mi>x</mi><mi>z</mi></mrow></mtd><mtd><mrow><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup><mi>y</mi><mi>z</mi></mrow></mtd></mtr></mtable><mo data-mjx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><mo stretchy="false">(</mo><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup><mi>z</mi><mo>−</mo><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup><mi>z</mi><mo>+</mo><mi>x</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mo stretchy="false">(</mo><mn>12</mn><msup><mi>x</mi><mn>2</mn></msup><mi>y</mi><mi>z</mi><mo>−</mo><mn>12</mn><msu