<math><mrow><mi>g</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup><mo>−</mo><msup><mi>a</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn><mtext>.</mtext></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mo>=</mo><mfrac><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi></mrow><mrow><mo stretchy="false">|</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo stretchy="false">|</mo></mrow></mfrac><mo>=</mo><mfrac><mrow><mi>x</mi><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>y</mi><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>z</mi><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup></msqrt></mfrac></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mtext> </mtext><mi mathvariant="bold">F</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup><msup><mo minsize="1.2em" maxsize="1.2em">)</mo><mrow data-mjx-texclass="ORD"><mi>n</mi><mo>+</mo><mo>+</mo><mn>1</mn><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>=</mo><msup><mrow data-mjx-texclass="ORD"><mo minsize="1.2em" maxsize="1.2em">(</mo><msup><mi>a</mi><mn>2</mn></msup><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow><mrow data-mjx-texclass="ORD"><mi>n</mi><mo>+</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>=</mo><msup><mi>a</mi><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>n</mi><mo>+</mo><