<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><msub><mo data-mjx-texclass="OP">∮</mo><mrow data-mjx-texclass="ORD"><mi>∂</mi><mi>R</mi></mrow></msub><mi>M</mi><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>u</mi><mo>+</mo><mi>N</mi><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>v</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="1in"></mspace><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mi>a</mi><mi>b</mi></msubsup><mo minsize="1.623em" maxsize="1.623em">[</mo><mi>M</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>u</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>,</mo><mi>v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mtext> </mtext><mfrac><mrow><mi mathvariant="normal">d</mi><mi>u</mi></mrow><mrow><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>+</mo><mi>N</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>u</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>,</mo><mi>v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mtext> </mtext><mfrac><mrow><mi mathvariant="normal">d</mi><mi>v</mi></mrow><mrow><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo minsize="1.623em" maxsize="1.623em">]</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mtd></mtr></mtable></math>
