<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi data-mjx-variant="-tex-calligraphic" mathvariant="script">S</mi></msub><mfrac><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup></mrow><msqrt><mn>1</mn><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup></msqrt></mfrac><mtext> </mtext><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∬</mo><mi data-mjx-variant="-tex-calligraphic" mathvariant="script">S</mi></msub><mo stretchy="false">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo stretchy="false">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>y</mi><mo>=</mo><mn>4</mn><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>x</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>y</mi><mtext> </mtext><mo stretchy="false">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>4</mn><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>x</mi><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>=</mo><mn>4</mn><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mo>=</mo><mfrac><mn>8</mn><mn>3</mn></mfrac></mrow></mtd></mtr></mtable></math>
