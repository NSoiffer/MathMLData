<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mn>2</mn><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>φ</mi></mrow></mfrac></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>2</mn><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr></mtable></math>
