<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mfrac><mrow><mi>∂</mi><msub><mi>G</mi><mn>3</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>∂</mi><msub><mi>G</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mo minsize="1.623em" maxsize="1.623em">[</mo><mn>2</mn><mi>t</mi><msub><mi>F</mi><mn>1</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mi>x</mi><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mi>y</mi><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="3.5in"></mspace><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mi>z</mi><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo minsize="1.623em" maxsize="1.623em">]</mo><mspace width="0.167em"></mspace><mi>d</mi><mi>t</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mfrac><mi>d</mi><mrow><mi>d</mi><mi>t</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">[</mo><msup><mi>t</mi><mn>2</mn></msup><msub><mi>F</mi><mn>1</mn></msub><mo stretchy="false">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo stretchy="false">)</mo><mo minsize="1.623em" maxsize="1.623em">]</mo><mspace width="0.167em"></mspace><mi>d</mi><mi>t</mi><mo>=</mo><mo minsize="1.623em" maxsize="1.623em">[</mo><msup><mi>t</mi><mn>2</mn></msup><msub><mi>F</mi><mn>1</mn></msub><mo stretchy="false">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo stretchy="false">)</mo><msubsup><mo minsize="1.623em" maxsize="1.623em">]</mo><mrow data-mjx-texclass="ORD"><mi>t</mi><mo>=</mo><mn>0</mn></mrow><mrow data-mjx-texclass="ORD"><mi>t</mi><mo>=</mo><mn>1</mn></mrow></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><msub><mi>F</mi><mn>1</mn></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∭</mo><mi>V</mi></msub><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>x</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>y</mi><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>z</mi><mtext> </mtext><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo data-mjx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>x</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>y</mi><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">[</mo><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">]</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="1in"></mspace><mtext>by the fundamental theorem of calculus</mtext></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∬</mo><mi>R</mi></msub><mo minsize="1.2em" maxsize="1.2em">[</mo><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">]</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∬</mo><mi>R</mi></msub><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>−</mo><msub><mo data-mjx-texclass="OP">∬</mo><mi>R</mi></msub><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi></mrow></mtd></mtr></mtable></math>
<math><mrow><mi mathvariant="bold">F</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mtext>.</mtext></mrow></math>
<math><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>⋅</mo><mi mathvariant="bold">F</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mtext>.</mtext></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><msub><mi>S</mi><mn>1</mn></msub></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">{</mo><mtext> </mtext><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">|</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>x</mi><mo>≤</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>y</mi><mo>≤</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mi>z</mi><mo>=</mo><mn>1</mn><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">}</mo><mtext> </mtext><mtext>with outward normal </mtext><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mo>=</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd><msub><mi>S</mi><mn>2</mn></msub></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">{</mo><mtext> </mtext><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">|</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>x</mi><mo>≤</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>y</mi><mo>≤</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mi>z</mi><mo>=</mo><mn>0</mn><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">}</mo><mtext> </mtext><mtext>with outward normal </mtext><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mo>=</mo><mo>−</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd><msub><mi>S</mi><mn>3</mn></msub></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">{</mo><mtext> </mtext><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">|</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>x</mi><mo>≤</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>z</mi><mo>≤</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mi>y</mi><mo>=</mo><mn>1</mn><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">}</mo><mtext> </mtext><mtext>with outward normal </mtext><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mo>=</mo><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd><msub><mi>S</mi><mn>4</mn></msub></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">{</mo><mtext> </mtext><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">|</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>x</mi><mo>≤</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>z</mi><mo>≤</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mi>y</mi><mo>=</mo><mn>0</mn><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">}</mo><mtext> </mtext><mtext>with outward normal </mtext><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mo>=</mo><mo>−</mo><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd><msub><mi>S</mi><mn>5</mn></msub></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">{</mo><mtext> </mtext><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">|</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>y</mi><mo>≤</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mn>0</mn><mo>≤</mo><mi>z</mi><mo>≤</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mi>x</mi><mo>=</mo><mn>1</mn><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">}</mo><mtext> </mtext><mtext>with outward normal </mtext><mover><mi mathvariant="bo