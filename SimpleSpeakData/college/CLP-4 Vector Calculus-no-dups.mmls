<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msup><mi>cos</mi><mn>3</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><msup><mi>sin</mi><mn>3</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><mn>2</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi mathvariant="bold">v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mo>−</mo><mn>3</mn><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><mn>3</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><mn>4</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo stretchy="false">(</mo><mo>−</mo><mn>3</mn><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><mn>3</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mo stretchy="false">|</mo><mi mathvariant="bold">v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">|</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><msqrt><mn>9</mn><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>+</mo><mn>9</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>+</mo><mn>16</mn></msqrt><mo>=</mo><mn>5</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi></mrow></mtd></mtr></mtable></math>
<math><mrow><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mo stretchy="false">|</mo><mi mathvariant="bold">v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">|</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>t</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mn>5</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>t</mi><mo>=</mo><mfrac><mn>5</mn><mn>2</mn></mfrac><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><msubsup><mo minsize="1.623em" maxsize="1.623em">|</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mo>=</mo><mfrac><mn>5</mn><mn>2</mn></mfrac></mrow></math>
