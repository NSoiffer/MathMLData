<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mfrac><mn>1</mn><mrow><mn>2</mn><mo stretchy="false">|</mo><mi>V</mi><mo stretchy="false">|</mo></mrow></mfrac><msub><mo data-mjx-texclass="OP">∬</mo><mrow data-mjx-texclass="ORD"><mi>∂</mi><mi>V</mi></mrow></msub><mo stretchy="false">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo stretchy="false">|</mo><mi>V</mi><mo stretchy="false">|</mo></mrow></mfrac><msub><mo data-mjx-texclass="OP">∭</mo><mi>V</mi></msub><mo stretchy="false">(</mo><mn>2</mn><mi>x</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mn>2</mn><mi>y</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mn>2</mn><mi>z</mi><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>V</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo stretchy="false">(</mo><mover><mi>x</mi><mo stretchy="false">¯</mo></mover><mo>,</mo><mover><mi>y</mi><mo stretchy="false">¯</mo></mover><mo>,</mo><mover><mi>z</mi><mo stretchy="false">¯</mo></mover><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable></math>
