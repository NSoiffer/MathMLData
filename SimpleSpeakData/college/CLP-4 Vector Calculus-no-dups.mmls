<math><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>S</mi></msub><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi mathvariant="bold">F</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∫</mo><msub><mi>C</mi><mn>1</mn></msub></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>+</mo><msub><mo data-mjx-texclass="OP">∫</mo><msub><mi>C</mi><mn>2</mn></msub></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>+</mo><msub><mo data-mjx-texclass="OP">∫</mo><msub><mi>C</mi><mn>3</mn></msub></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>+</mo><msub><mo data-mjx-texclass="OP">∫</mo><msub><mi>C</mi><mn>4</mn></msub></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>=</mo><mfrac><mn>4</mn><mn>3</mn></mfrac></mrow></math>
