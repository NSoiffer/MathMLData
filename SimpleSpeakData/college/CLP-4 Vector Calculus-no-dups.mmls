<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>±</mo><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo>×</mo><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>∓</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mfrac><mi>x</mi><msqrt><mn>2</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup></msqrt></mfrac><mspace width="0.167em"></mspace><mo>,</mo><mn>1</mn><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mfrac><mi>z</mi><msqrt><mn>2</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup></msqrt></mfrac><mo data-mjx-texclass="CLOSE">)</mo></mrow><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd><mrow><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">|</mo><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo>×</mo><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo data-mjx-texclass="CLOSE">|</mo></mrow><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</m