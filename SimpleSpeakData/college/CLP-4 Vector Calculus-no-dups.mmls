<math><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mrow data-mjx-texclass="ORD"><mi>∂</mi><mi mathvariant="normal">Ω</mi></mrow></msub><mi>f</mi><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∭</mo><mi mathvariant="normal">Ω</mi></msub><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>V</mi></mrow></math>
