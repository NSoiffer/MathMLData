<math><mrow><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>π</mi></msubsup><msup><mi>sin</mi><mi>n</mi></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>θ</mi><mo>=</mo><mfrac><mrow><mi>n</mi><mo>−</mo><mn>1</mn></mrow><mi>n</mi></mfrac><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>π</mi></msubsup><msup><mi>sin</mi><mrow data-mjx-texclass="ORD"><mi>n</mi><mo>−</mo><mn>2</mn></mrow></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>θ</mi></mrow></math>
<math><mrow><mi>n</mi><mo>=</mo><mn>2</mn><mo>,</mo><mn>3</mn><mo>,</mo><mn>4</mn><mo>,</mo><mo>…</mo><mtext>.</mtext></mrow></math>
<math><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>=</mo><mn>4</mn><mi>y</mi></mrow></math>
<math><mrow><mi mathvariant="bold">F</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup><mi>y</mi><mo stretchy="false">)</mo><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mo stretchy="false">(</mo><mi>y</mi><mo>−</mo><mi>x</mi><msup><mi>y</mi><mn>2</mn></msup><mo stretchy="false">)</mo><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mo stretchy="false">(</mo><mi>z</mi><mo>+</mo><mn>2</mn><mi>x</mi><mo>+</mo><mn>3</mn><mi>y</mi><mo stretchy="false">)</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></math>
<math><mrow><mi mathvariant="bold">F</mi><mo>=</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><msup><mi>x</mi><mn>3</mn></msup><mo>+</mo><msup><mi>e</mi><msup><mi>z</mi><mn>2</mn></msup></msup><mo minsize="1.623em" maxsize="1.623em">)</mo><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><msup><mi>y</mi><mn>3</mn></msup><mo>+</mo><mi>x</mi><mroot><mrow><mi>tan</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>z</mi></mrow><mn>3</mn></mroot><mo minsize="1.623em" maxsize="1.623em">)</mo><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mn>4</mn><mi>z</mi><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></math>
