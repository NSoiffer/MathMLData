<math><mtable displaystyle="true" columnspacing="1em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>S</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi><mo>=</mo><mo>−</mo><msub><mo data-mjx-texclass="OP">∬</mo><msub><mi>S</mi><mi>ε</mi></msub></msub><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mo>−</mo><mfrac><mn>1</mn><msup><mi>ε</mi><mn>2</mn></msup></mfrac><mo data-mjx-texclass="CLOSE">)</mo></mrow><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi><mo>=</mo><mfrac><mn>1</mn><msup><mi>ε</mi><mn>2</mn></msup></mfrac><mo stretchy="false">(</mo><mn>4</mn><mi>π</mi><msup><mi>ε</mi><mn>2</mn></msup><mo stretchy="false">)</mo><mo>=</mo><mn>4</mn><mi>π</mi></mrow></mtd></mtr></mtable></math>
