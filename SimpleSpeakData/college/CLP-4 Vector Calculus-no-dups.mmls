<math><mrow><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mi mathvariant="normal">d</mi><mi>S</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>2</mn><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mn>0</mn><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mn>2</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mi mathvariant="normal">d</mi><mi>θ</mi><mi mathvariant="normal">d</mi><mi>y</mi></mrow></math>
<math><mrow><mi mathvariant="bold">F</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>2</mn><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>+</mo><mi>y</mi><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mn>2</mn><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>+</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mi>y</mi><mo>+</mo><mn>2</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></math>
