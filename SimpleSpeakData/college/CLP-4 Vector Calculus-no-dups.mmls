<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mo minsize="1.2em" maxsize="1.2em">[</mo><msub><mi>F</mi><mn>1</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>+</mo><msub><mi>F</mi><mn>2</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo minsize="1.2em" maxsize="1.2em">]</mo><mo>∧</mo><mo minsize="1.2em" maxsize="1.2em">[</mo><msub><mi>G</mi><mn>1</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>+</mo><msub><mi>G</mi><mn>2</mn></msub><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo minsize="1.2em" maxsize="1.2em">]</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msub><mi>F</mi><mn>1</mn></msub><msub><mi>G</mi><mn>2</mn></msub><mo>−</mo><msub><mi>F</mi><mn>2</mn></msub><msub><mi>G</mi><mn>1</mn></msub><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>∧</mo><mi mathvariant="normal">d</mi><mi>y</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo data-mjx-texclass="OP" movablelimits="true">det</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mtable columnalign="center" columnspacing="1em" rowspacing="4pt"><mtr><mtd><msub><mi>F</mi><mn>1</mn></msub></mtd><mtd><msub><mi>F</mi><mn>2</mn></msub></mtd></mtr><mtr><mtd><msub><mi>G</mi><mn>1</mn></msub></mtd><mtd><msub><mi>G</mi><mn>2</mn></msub></mtd></mtr></mtable><mo data-mjx-texclass="CLOSE">]</mo></mrow><mi mathvariant="normal">d</mi><mi>x</mi><mo>∧</mo><mi mathvariant="normal">d</mi><mi>y</mi></mrow></mtd></mtr></mtable></math>
