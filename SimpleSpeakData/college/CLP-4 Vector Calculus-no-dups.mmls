<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>±</mo><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac><mo>×</mo><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>φ</mi></mrow></mfrac><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>θ</mi><mi mathvariant="normal">d</mi><mi>φ</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>∓</mo><mn>4</mn><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mtext> </mtext><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mtext> </mtext><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mtext> </mtext><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo minsize="1.2em" maxsize="1.2em">)</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi><mi mathvariant="normal">d</mi><mi>φ</mi></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>4</mn><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mtext> </mtext><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mtext> </mtext><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mtext> </mtext><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo minsize="1.2em" maxsize="1.2em">)</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi><mi mathvariant="normal">d</mi><mi>φ</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>2</mn><mspace width="0.167em"></mspace><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>φ</mi><mo stretchy="false">)</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi><mi mathvariant="normal">d</mi><mi>φ</mi></mrow></mtd></mtr></mtable></math>
