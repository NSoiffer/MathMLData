mn></msup><mn>7</mn></mfrac><mo data-mjx-texclass="CLOSE">)</mo></mrow><mo>=</mo><mfrac><mrow><msup><mn>2</mn><mn>10</mn></msup><mo>⋅</mo><mn>37</mn><msqrt><mn>2</mn></msqrt></mrow><mrow><mn>7</mn><mo>⋅</mo><msup><mn>3</mn><mn>3</mn></msup></mrow></mfrac></mrow></mtd></mtr><mtr><mtd><mover><mi>x</mi><mo accent="true">―</mo></mover></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mrow><mo data-mjx-texclass="OP">∫</mo><mi>x</mi><mi>ρ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>s</mi></mrow><mrow><mo data-mjx-texclass="OP">∫</mo><mi>ρ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>s</mi></mrow></mfrac><mo>=</mo><mfrac><mfrac><mrow><msup><mn>2</mn><mn>5</mn></msup><mo>⋅</mo><mn>103</mn><msqrt><mn>2</mn></msqrt></mrow><mn>15</mn></mfrac><mfrac><mrow><msup><mn>2</mn><mn>3</mn></msup><mo>⋅</mo><mn>11</mn><msqrt><mn>2</mn></msqrt></mrow><mn>3</mn></mfrac></mfrac><mo>=</mo><mfrac><mn>412</mn><mn>55</mn></mfrac><mo>≈</mo><mn>7.5</mn></mrow></mtd></mtr><mtr><mtd><mover><mi>y</mi><mo accent="true">―</mo></mover></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mrow><mo data-mjx-texclass="OP">∫</mo><mi>y</mi><mi>ρ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>s</mi></mrow><mrow><mo data-mjx-texclass="OP">∫</mo><mi>ρ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>s</mi></mrow></mfrac><mo>=</mo><mfrac><mrow><mo>−</mo><mfrac><mrow><msup><mn>2</mn><mn>5</mn></msup><mo>⋅</mo><mn>23</mn><msqrt><mn>2</mn></msqrt></mrow><mn>15</mn></mfrac></mrow><mfrac><mrow><msup><mn>2</mn><mn>3</mn></msup><mo>⋅</mo><mn>11</mn><msqrt><mn>2</mn></msqrt></mrow><mn>3</mn></mfrac></mfrac><mo>=</mo><mo>−</mo><mfrac><mn>92</mn><mn>55</mn></mfrac><mo>≈</mo><mo>−</mo><mn>1.7</mn></mrow></mtd></mtr><mtr><mtd><mover><mi>z</mi><mo accent="true">―</mo></mover></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mrow><mo data-mjx-texclass="OP">∫</mo><mi>z</mi><mi>ρ</mi><mspace width="0.167em"></mspac