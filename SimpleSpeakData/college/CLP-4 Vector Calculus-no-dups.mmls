<math><mrow><mi mathvariant="bold">G</mi><mo>=</mo><mo stretchy="false">(</mo><msup><mi>y</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>+</mo><mi>x</mi><msup><mi>y</mi><mn>3</mn></msup><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mo stretchy="false">(</mo><mn>2</mn><mi>x</mi><mi>y</mi><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>+</mo><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup><msup><mi>y</mi><mn>2</mn></msup><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mn>3</mn><mi>x</mi><msup><mi>y</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo>=</mo><mi mathvariant="bold">F</mi><mo>−</mo><mi>x</mi><msup><mi>y</mi><mn>3</mn></msup><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mo stretchy="false">(</mo><msup><mi>y</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>+</mo><mi>x</mi><msup><mi>y</mi><mn>3</mn></msup><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>+</mo><mo stretchy="false">(</mo><mn>2</mn><mi>x</mi><mi>y</mi><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>+</mo><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup><msup><mi>y</mi><mn>2</mn></msup><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>+</mo><mn>3</mn><mi>x</mi><msup><mi>y</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>−</mo><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mi>x</mi><msup><mi>y</mi><mn>3</mn></msup><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><mi>φ</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>−</mo><mi>φ</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>−</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mover><mover><mrow><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>t</mi></mrow></msup><mo minsize="1.2em" maxsize="1.2em">(</mo><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mo>−</mo><mi>t</mi></mrow></msup><msup><mo minsize="1.2em" maxsize="1.2em">)</mo><mn>3</mn></msup><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mrow><mo>⏞</mo></mover><mrow data-mjx-texclass="ORD"><mi>x</mi><msup><mi>y</mi><mn>3</mn></msup><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mrow></mover><mo>⋅</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mover><mover><mrow><mn>2</mn><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>t</mi></mrow></msup><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mo>−</mo><mi>t</mi></mrow></msup><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow></mfrac><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow><mo>⏞</mo></mover><mrow data-mjx-texclass="ORD"><msup><mi mathvariant="bold">r</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mover><mo minsize="1.623em" maxsize="1.623em">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><mi>φ</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><msup><mi>e</mi><mn>2</mn></msup><mo>,</mo><mfrac><mn>1<