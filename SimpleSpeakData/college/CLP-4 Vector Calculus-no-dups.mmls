<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi mathvariant="bold">F</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>3</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>3</mn></msub></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>⋅</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi>F</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>3</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mo>−</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>3</mn></msub></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mo>+</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mrow><msup><mi>∂</mi><mn>2</mn></msup><msub><mi>F</mi><mn>3</mn></msub></mrow><mrow><mi>∂</mi><mi>x</mi><mi>∂</mi><mi>y</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><msup><mi>∂</mi><mn>2</mn></msup><msub><mi>F</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><mi>x</mi><mi>∂</mi><mi>z</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><msup><mi>∂</mi><mn>2</mn></msup><msub><mi>F</mi><mn>3</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi><mi>∂</mi><mi>x</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><msup><mi>∂</mi><mn>2</mn></msup><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi><mi>∂</mi><mi>z</mi></mrow></mfrac><mo>+</mo><mfrac><mrow><msup><mi>∂</mi><mn>2</mn></msup><msub><mi>F</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi><mi>∂</mi><mi>x</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><msup><mi>∂</mi><mn>2</mn></msup><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi><mi>∂</mi><mi>y</mi></mrow></mfrac></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>0</mn></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd/></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo>−</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo>−</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="1in"></mspace><mo>+</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo>−</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>0</mn></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>⋅</mo><mo minsize="1.2em" maxsize="1.2em">[</mo><mi>f</mi><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo>×</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>h</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">]</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi><mo>⋅</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo>×</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>h</mi><mo stretchy="false">)</mo><mo>+</mo><mi>f</mi><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>⋅</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo>×</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>h</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi><mo>⋅</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo>×</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>h</mi><mo stretchy="false">)</mo><mo>+</mo><mi>f</mi><mo minsize="1.2em" maxsize="1.2em">[</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo stretchy="false">)</mo><mo>⋅</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>h</mi><mo>−</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo>⋅</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>h</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">]</mo></mrow></mtd></mtr></mtable></math>
<math><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo>=</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>h</mi><mo>=</mo><mn>0</mn><mtext>,</mtext></mrow></math>
<math><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>⋅</mo><mo minsize="1.2em" maxsize="1.2em">[</mo><mi>f</mi><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo>×</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">]</mo><mo>=</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi><mo>⋅</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo>×</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>h</mi><mo stretchy="false">)</mo></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>⋅</mo><mo stretchy="false">(</mo><mi>f</mi><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo>−</mo><mi>g</mi><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi><mo stretchy="false">)</mo><mo>⋅</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo stretchy="false">)</mo><mo>+</mo><mi>f</mi><mspace width="0.167em"></mspace><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>⋅</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo stretchy="false">)</mo><mo>−</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>g</mi><mo stretchy="false">)</mo><mo>⋅</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi><mo stretchy="false">)</mo><mo>+</mo><mi>g</mi><mspace width="0.167em"></mspace><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>⋅</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>f</mi><mspace width="0.167em"></mspace><msup><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mn>2</mn></msup><mi>g</mi><mo>−</mo><mi>g</mi><mspace width="0.167em"></mspace><msup><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mn>2</mn></msup><mi>f</mi></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi mathvariant="bold">F</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munderover><mo data-mjx-texclass="OP">∑</mo><mrow data-mjx-texclass="ORD"><mi>ℓ</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></munderover><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>ℓ</mi></msub><mfrac><mi>∂</mi><mrow><mi>∂</mi><msub><mi>x</mi><mi>ℓ</mi></msub></mrow></mfrac><mo>×</mo><mo minsize="2.047em" maxsize="2.047em">(</mo><munderover><mo data-mjx-texclass="OP">∑</mo><mrow data-mjx-texclass="ORD"><mi>m</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></munderover><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>m</mi></msub><mfrac><mi>∂</mi><mrow><mi>∂</mi><msub><mi>x</mi><mi>m</mi></msub></mrow></mfrac><mo>×</mo><munderover><mo data-mjx-texclass="OP">∑</mo><mrow data-mjx-texclass="ORD"><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></munderover><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>n</mi></msub><msub><mi>F</mi><mi>n</mi></msub><mo minsize="2.047em" maxsize="2.047em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munderover><mo data-mjx-texclass="OP">∑</mo><mrow data-mjx-texclass="ORD"><mi>ℓ</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></munderover><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>ℓ</mi></msub><mo>×</mo><mo minsize="1.2em" maxs