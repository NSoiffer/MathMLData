rmal">a</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">e</mi></mrow></mfrac></msub><mo stretchy="false">(</mo><mn>0</mn><mo>+</mo><mn>0</mn><mi>z</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo>=</mo><mn>0</mn></mrow></mtd></mtr><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mfrac linethickness="0pt"><mrow><mi>x</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi mathvariant="normal">f</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">e</mi></mrow></mfrac></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mo stretchy="false">(</mo><mo>−</mo><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∬</mo><mfrac linethickness="0pt"><mrow><mi>x</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi mathvariant="normal">f</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">e</mi></mrow></mfrac></msub><mo>−</mo><mo stretchy="false">(</mo><mi>y</mi><mo>+</mo><mn>0</mn><mi>z</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo>=</mo><mo>−</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>a</mi></msubsup><mi>d</mi><mi>r</mi><mspace width="0.167em"></mspace><mi>r</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mi mathvariant="normal">d</mi><mi>θ</mi><mtext> </mtext><mi>r</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>a</mi></msubsup><msup><mi>r</mi><mn>2</mn></msup><mspace width="0.167em"></mspace><mi>d</mi><mi>r</mi><mo>=</mo><mo>−</mo><mfrac><msup><mi>a</mi><mn>3</mn></msup><mn>3</mn></mfrac></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>S</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∭</mo><mi>V</mi></msub><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>⋅</mo><mi mathvariant="bold">F</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>V</mi><mo>−</mo><msub><mo data-mjx-texclass="OP">∬</mo><mfrac linethickness="0pt"><mrow><mi>x</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi mathvariant="normal">f</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">e</mi></mrow></mfrac></msub><mspace width="-3pt"></mspace><mi mathvariant="bold">F</mi><mo>⋅</mo><mo stretchy="false">(</mo><mo>−</mo><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="1in"></mspace><mo>−</mo><msub><mo data-mjx-texclass="OP">∬</mo><mfrac linethickness="0pt"><mrow><mi>y</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi mathvariant="normal">f</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">e</mi></mrow></mfrac></msub><mspace width="-3pt"></mspace><mi mathvariant="bold">F</mi><mo>⋅</mo><mo stretchy="false">(</mo><mo>−</mo><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi><mo>−</mo><msub><mo data-mjx-texclass="OP">∬</mo><mfrac linethickness="0pt"><mrow><mi>z</mi><mo>=</mo><mn>0</mn></mrow><mrow><mi mathvariant="normal">f</mi><mi mathvariant="normal">a</mi><mi mathvariant="normal">c</mi><mi mathvariant="normal">e</mi></mrow></mfrac></msub><mspace width="-3pt"></mspace><mi mathvariant="bold">F</mi><mo>⋅</mo><mo stretchy="false">(</mo><mo>−</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mfrac><mi>π</mi><mn>6</mn></mfrac><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo data-mjx-texclass="CLOSE">]</mo></mrow><msup><mi>a</mi><mn>3</mn></msup></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><msqrt><mn>2</mn></msqrt><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>z</mi><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><msqrt><mn>2</mn></msqrt><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><msqrt><mn>2</mn></msqrt><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd><mrow><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>±</mo><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>×</mo><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>θ</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>±</mo><mo data-mjx-texclass="OP" movablelimits="true">det</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mtable columnalign="center" columnspacing="1em" rowspacing="4pt"><mtr><mtd><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mtd></mtr><mtr><mtd><mrow><mo>−</mo><msqrt><mn>2</mn></msqrt><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mrow></mtd><mtd><mrow><msqrt><mn>2</mn></msqrt><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></mrow></mtd><mtd><mn>0</mn></mtd></mtr><mtr><mtd><mn>0</mn></mtd><mtd><mn>0</mn></mtd><mtd><mn>1</mn></mtd></mtr></mtable><mo data-mjx-texclass="CLOSE">]</mo></mrow><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>±</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msqrt><mn>2</mn></msqrt><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><msqrt><mn>2</mn></msqrt><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo minsize="1.2em" maxsize="1.2em">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi><mtext> </mtext><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mi mathvariant="bold">F</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">[</mo><msqrt><mn>2</mn></msqrt><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>−</mo><mi>z</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><msqrt><mn>2</mn></msqrt><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>+</mo><mi>z</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mo stretchy="false">(</mo><mo>⋯</mo><mo stretchy="false">)</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo minsize="1.2em" maxsize="1.2em">]</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="2in"></mspace><mo>⋅</mo><mo minsize="1.2em" maxsize="1.2em">[</mo><mo>−</mo><msqrt><mn>2</mn></msqrt><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><msqrt><mn>2</mn></msqrt><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo minsize="1.2em" maxsize="1.2em">]</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mn>2</mn><mo minsize="1.2em" maxsize="1.2em">[</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>−</mo><mi>z</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>+</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>+</mo><mi>z</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">]</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mn>2</mn><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>θ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnspacing="1em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msup><mi>z</mi><mn>2</mn></msup><mo>=</mo><mn>4</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><msup><mi>y</mi><mn>2</mn></msup><mo>=</mo><mn>4</mn><mo>−</mo><mn>2</mn><mo>=</mo><mn>2</mn></mrow></mtd></mtr></mtable></math>
