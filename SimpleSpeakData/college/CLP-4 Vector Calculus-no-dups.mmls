<math><mtable displaystyle="true" columnalign="right left right left" columnspacing="0em 2em 0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mover><mi mathvariant="bold">T</mi><mo stretchy="false">^</mo></mover><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mrow><mi mathvariant="bold">v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">|</mo><mi mathvariant="bold">v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">|</mo></mrow></mfrac><mo>=</mo><mfrac><mn>1</mn><mn>5</mn></mfrac><mo stretchy="false">(</mo><mo>−</mo><mn>3</mn><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><mn>3</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mover><mi mathvariant="bold">T</mi><mo stretchy="false">^</mo></mover><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mi>π</mi><mn>6</mn></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>5</mn></mfrac><mo minsize="1.623em" maxsize="1.623em">(</mo><mo>−</mo><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>,</mo><mfrac><mrow><mn>3</mn><msqrt><mn>3</mn></msqrt></mrow><mn>2</mn></mfrac><mo>,</mo><mn>4</mn><mo minsize="1.623em" maxsize="1.623em">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><msup><mover><mi mathvariant="bold">T</mi><mo stretchy="false">^</mo></mover><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>5</mn></mfrac><mo stretchy="false">(</mo><mn>3</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><mn>3</mn><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><msup