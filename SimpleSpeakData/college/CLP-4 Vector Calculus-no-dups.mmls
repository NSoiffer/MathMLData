<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mo stretchy="false">(</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi mathvariant="bold">F</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munderover><mo data-mjx-texclass="OP">∑</mo><mrow data-mjx-texclass="ORD"><mi>ℓ</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></munderover><msub><mi>δ</mi><mrow data-mjx-texclass="ORD"><mi>ℓ</mi><mo>,</mo><mi>n</mi></mrow></msub><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>m</mi></msub><mtext> </mtext><mfrac><mrow><msup><mi>∂</mi><mn>2</mn></msup><msub><mi>F</mi><mi>n</mi></msub></mrow><mrow><mi>∂</mi><msub><mi>x</mi><mi>ℓ</mi></msub><mi>∂</mi><msub><mi>x</mi><mi>m</mi></msub></mrow></mfrac><mo>−</mo><munderover><mo data-mjx-texclass="OP">∑</mo><mrow data-mjx-texclass="ORD"><mi>ℓ</mi><mo>,</mo><mi>m</mi><mo>,</mo><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></munderover><msub><mi>δ</mi><mrow data-mjx-texclass="ORD"><mi>ℓ</mi><mo>,</mo><mi>m</mi></mrow></msub><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mi>n</mi></msub><mtext> </mtext><mfrac><mrow><msup><mi>∂</mi><mn>2</mn></msup><msub><mi>F</mi><mi>n</mi></msub></mrow><mrow><mi>∂</mi><msub><mi>x</mi><mi>ℓ</mi></msub><mi>∂</mi><msub><mi>x</mi><mi>m</mi></msub></mrow></mfrac></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munderover><mo data-mjx-texclass="OP">∑</mo><mrow data-mjx-texclass="ORD"><mi>m</mi><mo>,</mo><mi>n</mi><mo>=</mo><mn>1</mn></mrow><mn>3</mn></munderover><msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>