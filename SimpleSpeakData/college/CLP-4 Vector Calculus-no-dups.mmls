<math><mrow><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo><mo>=</mo><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>y</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mtext>,</mtext></mrow></math>
<math><mtable displaystyle="true" columnspacing="1em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∫</mo><msub><mi>C</mi><mn>2</mn></msub></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn></mrow><mn>1</mn></msubsup><mi mathvariant="bold">F</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>y</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>⋅</mo><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mtext> </mtext><mi mathvariant="normal">d</mi><mi>y</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn></mrow><mn>1</mn></msubsup><mover><mover><msup><mi>y</mi><mn>2</mn></msup><mo>⏞</mo></mover><mrow data-mjx-texclass="ORD"><mi>x</mi><msup><mi>y</mi><mn>2</mn></msup></mrow></mover><mtext> </mtext><mi mathvariant="normal">d</mi><mi>y</mi><mo>=</mo><msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mfrac><msup><mi>y</mi><mn>3</mn></msup><mn>3</mn></mfrac><mo data-mjx-texclass="CLOSE">]</mo></mrow><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn></mrow><mn>1</mn></msubsup><mo>=</mo><mfrac><mn>2</mn><mn>3</mn></mfrac></mrow></mtd></mtr></mtable></math>
<math><mrow><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>=</mo><mi>x</mi><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></math>
