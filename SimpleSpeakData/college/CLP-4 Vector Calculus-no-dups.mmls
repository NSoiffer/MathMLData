<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi mathvariant="bold">a</mi><mo>⋅</mo><msub><mo data-mjx-texclass="OP">∬</mo><mrow data-mjx-texclass="ORD"><mi>∂</mi><mi mathvariant="normal">Ω</mi></mrow></msub><mi mathvariant="bold">F</mi><mo>×</mo><mi mathvariant="bold">n</mi><mtext> </mtext><mi mathvariant="normal">d</mi><mi>S</mi><mo>=</mo><mo>−</mo><mi mathvariant="bold">a</mi><mo>⋅</mo><msub><mo data-mjx-texclass="OP">∭</mo><mi mathvariant="normal">Ω</mi></msub><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi mathvariant="bold">F</mi><mtext> </mtext><mi mathvariant="normal">d</mi><mi>V</mi></mrow></mtd></mtr><mtr><mtd><mrow><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace></mrow></mtd><mtd><mrow><mi mathvariant="bold">a</mi><mo>⋅</mo><mo minsize="2.047em" maxsize="2.047em">{</mo><msub><mo data-mjx-texclass="OP">∬</mo><mrow data-mjx-texclass="ORD"><mi>∂</mi><mi mathvariant="normal">Ω</mi></mrow></msub><mi mathvariant="bold">F</mi><mo>×</mo><mi mathvariant="bold">n</mi><mtext> </mtext><mi mathvariant="normal">d</mi><mi>S</mi><mo>+</mo><msub><mo data-mjx-texclass="OP">∭</mo><mi mathvariant="normal">Ω</mi></msub><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi mathvariant="bold">F</mi><mtext> </mtext><mi mathvariant="normal">d</mi><mi>V</mi><mo minsize="2.047em" maxsize="2.047em">}</mo><mo>=</mo><mn>0</mn></mrow></mtd></mtr></mtable></math>
