<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mi mathvariant="bold">F</mi></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mn>2</mn><mi>x</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><msup><mi>e</mi><mi>z</mi></msup><mo data-mjx-texclass="CLOSE">)</mo></mrow><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mi>π</mi><msup><mi>x</mi><mn>2</mn></msup><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mn>3</mn><msup><mi>e</mi><mi>z</mi></msup><mo data-mjx-texclass="CLOSE">)</mo></mrow><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mi>x</mi><mo>+</mo><mn>3</mn><mi>y</mi><mo data-mjx-texclass="CLOSE">)</mo></mrow><msup><mi>e</mi><mi>z</mi></msup><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo minsize="1.2em" maxsize="1.2em">(</mo><msup><mi>x</mi><mn>2</mn></msup><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mi>x</mi><msup><mi>e</mi><mi>z</mi></msup><mo>−</mo><mn>3</mn><mi>y</mi><msup><mi>e</mi><mi>z</mi></msup><mo>+</mo><mi>C</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi>φ</mi></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>2</mn><mi>x</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><msup><mi>e</mi><mi>z</mi></msup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mi>x</mi><msup><mi>e</mi><mi>z</mi></msup><mo>+</mo><msub><mi>ψ</mi><mn>1</mn></msub><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi>φ</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>π</mi><msup><mi>x</mi><mn>2</mn></msup><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mn>3</mn><msup><mi>e</mi><mi>z</mi></msup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mn>3</mn><mi>y</mi><msup><mi>e</mi><mi>z</mi></msup><mo>+</mo><msub><mi>ψ</mi><mn>2</mn></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi>φ</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><mn>3</mn><mi>y</mi><mo stretchy="false">)</mo><msup><mi>e</mi><mi>z</mi></msup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mo>−</mo><mi>x</mi><msup><mi>e</mi><mi>z</mi></msup><mo>−</mo><mn>3</mn><mi>y</mi><msup><mi>e</mi><mi>z</mi></msup><mo>+</mo><msub><mi>ψ</mi><mn>3</mn></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable></math>
<math><mrow><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><msup><mi>x</mi><mn>2</mn></msup><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mi>x</mi><msup><mi>e</mi><mi>z</mi></msup><mo>−</mo><mn>3</mn><mi>y</mi><msup><mi>e</mi><mi>z</mi></msup></mrow></math>
<math><mrow><msub><mi>ψ</mi><mn>1</mn></msub><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mo>−</mo><mn>3</mn><mi>y</mi><msup><mi>e</mi><mi>z</mi></msup><mtext>,</mtext></mrow></math>
