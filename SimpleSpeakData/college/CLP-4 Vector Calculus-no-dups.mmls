<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi>φ</mi></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>z</mi><mo>+</mo><msup><mi>e</mi><mi>y</mi></msup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="1in"></mspace><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mi>z</mi><mi>x</mi><mo>+</mo><mi>x</mi><msup><mi>e</mi><mi>y</mi></msup><mo>+</mo><msub><mi>ψ</mi><mn>1</mn></msub><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi>φ</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>x</mi><msup><mi>e</mi><mi>y</mi></msup><mo>−</mo><msup><mi>e</mi><mi>z</mi></msup><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="1in"></mspace><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mi>x</mi><msup><mi>e</mi><mi>y</mi></msup><mo>+</mo><msup><mi>e</mi><mi>z</mi></msup><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mo>+</mo><msub><mi>ψ</mi><mn>2</mn></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi>φ</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>1</mn><mo>+</mo><mi>x</mi><mo>+</mo><msup><mi>e</mi><mi>z</mi></msup><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="1in"></mspace><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mi>z</mi><mo>+</mo><mi>z</mi><mi>x</mi><mo>+</mo><msup><mi>e</mi><mi>z</mi></msup><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mo>+</mo><msub><mi>ψ</mi><mn>3</mn></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo stretchy="false">)</mo></mrow></mtd></mtr></mtable></math>
<math><mrow><mi>φ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mover><mo>=</mo><mo>?</mo></mover><mi>z</mi><mi>x</mi><mo>+</mo><mi>x</mi><msup><mi>e</mi><mi>y</mi></msup><mo>+</mo><msup><mi>e</mi><mi>z</mi></msup><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mo>+</mo><mi>z</mi></mrow></math>
<math><mrow><msub><mi>ψ</mi><mn>1</mn></msub><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><msup><mi>e</mi><mi>z</mi></msup><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mo>+</mo><mi>z</mi><mtext>,</mtext></mrow></math>
<math><mrow><msub><mi>ψ</mi><mn>2</mn></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mi>z</mi><mi>x</mi><mo>+</mo><mi>z</mi><mtext>,</mtext></mrow></math>
