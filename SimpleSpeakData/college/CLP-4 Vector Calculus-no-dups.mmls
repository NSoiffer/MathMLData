<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mi>t</mi><mspace width="0.167em"></mspace><mi mathvariant="bold">F</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>×</mo><mfrac><mrow><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>t</mi><mspace width="0.167em"></mspace><mi mathvariant="bold">F</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>×</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>x</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>y</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>z</mi><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>t</mi><mo data-mjx-texclass="OP" movablelimits="true">det</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mtable columnalign="center" columnspacing="1em" rowspacing="4pt"><mtr><mtd><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mtd></mtr><mtr><mtd><msub><mi>F</mi><mn>1</mn></msub></mtd><mtd><msub><mi>F</mi><mn>2</mn></msub></mtd><mtd><msub><mi>F</mi><mn>3</mn></msub></mtd></mtr><mtr><mtd><mi>x</mi></mtd><mtd><mi>y</mi></mtd><mtd><mi>z</mi></mtd></mtr></mtable><mo data-mjx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mi>G</mi><mn>3</mn></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi>t</mi><mo minsize="1.2em" maxsize="1.2em">[</mo><msub><mi>F</mi><mn>1</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mi>y</mi><mo>−</mo><msub><mi>F</mi><mn>2</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mi>x</mi><mo minsize="1.2em" maxsize="1.2em">]</mo><mspace width="0.167em"></mspace><mi>d</mi><mi>t</mi></mrow></mtd></mtr><mtr><mtd><mrow><msub><mi>G</mi><mn>2</mn></msub><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi>t</mi><mo minsize="1.2em" maxsize="1.2em">[</mo><msub><mi>F</mi><mn>3</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mi>x</mi><mo>−</mo><msub><mi>F</mi><mn>1</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">]</mo><mspace width="0.167em"></mspace><mi>d</mi><mi>t</mi></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mfrac><mrow><mi>∂</mi><msub><mi>G</mi><mn>3</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi>t</mi><mo minsize="1.623em" maxsize="1.623em">[</mo><msub><mi>F</mi><mn>1</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>+</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mi>t</mi><mi>y</mi><mo>−</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mi>t</mi><mi>x</mi><mo minsize="1.623em" maxsize="1.623em">]</mo><mspace width="0.167em"></mspace><mi>d</mi><mi>t</mi></mrow></mtd></mtr><mtr><mtd><mfrac><mrow><mi>∂</mi><msub><mi>G</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi>t</mi><mo minsize="1.623em" maxsize="1.623em">[</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>3</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mi>t</mi><mi>x</mi><mo>−</mo><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mi>t</mi><mi>z</mi><mo>−</mo><msub><mi>F</mi><mn>1</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo minsize="1.623em" maxsize="1.623em">]</mo><mspace width="0.167em"></mspace><mi>d</mi><mi>t</mi></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><msub><mi>G</mi><mn>3</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>∂</mi><msub><mi>G</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mo minsize="1.623em" maxsize="1.623em">[</mo><mn>2</mn><mi>t</mi><mspace width="0.167em"></mspace><msub><mi>F</mi><mn>1</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="1in"></mspace><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mi>y</mi><mspace width="0.167em"></mspace><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup><mi>z</mi><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>1</mn></msub></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="1in"></mspace><mo>−</mo><msup><mi>t</mi><mn>2</mn></msup><mi>x</mi><mspace width="0.167em"></mspace><mfrac><mrow><mi>∂</mi><msub><mi>F</mi><mn>2</mn></msub></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mi>x</mi><mo>,</mo><mi>t</mi><mi>y</mi><mo>,</mo><mi>t</mi><mi>z</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>−</mo><msup>