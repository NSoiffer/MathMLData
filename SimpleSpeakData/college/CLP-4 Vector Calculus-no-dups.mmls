<math><mrow><mover><mi mathvariant="bold">N</mi><mo stretchy="false">^</mo></mover><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo><mo>=</mo><mfrac><mrow><msup><mover><mi mathvariant="bold">T</mi><mo stretchy="false">^</mo></mover><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow><mo stretchy="false">|</mo><msup><mover><mi mathvariant="bold">T</mi><mo stretchy="false">^</mo></mover><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo><mo stretchy="false">|</mo></mrow></mfrac><mo>=</mo><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></math>
<math><mtable displaystyle="true" columnspacing="1em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mfrac><mrow><mi mathvariant="normal">d</mi><mover><mi mathvariant="bold">T</mi><mo stretchy="false">^</mo></mover></mrow><mrow><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mfrac><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="2em"></mspace><mfrac><mrow><mi mathvariant="normal">d</mi><mi>s</mi></mrow><mrow><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mfrac><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo><mo>=</mo><mo stretchy="false">|</mo><mi mathvariant="bold">v</mi><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo><mo stretchy="false">|</mo><mo>=</mo><mn>4</mn></mrow></mtd></mtr></mtable></math>
