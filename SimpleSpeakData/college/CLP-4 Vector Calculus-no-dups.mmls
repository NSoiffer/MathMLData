<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mn>2</mn><mi>x</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><msup><mi>e</mi><mi>z</mi></msup><mo data-mjx-texclass="CLOSE">)</mo></mrow></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mi>a</mi><msup><mi>x</mi><mn>2</mn></msup><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><mn>3</mn><msup><mi>e</mi><mi>z</mi></msup><mo data-mjx-texclass="CLOSE">)</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="1in"></mspace><mspace width="0.278em"></mspace><mo stretchy="false">⟺</mo><mspace width="0.278em"></mspace><mspace width="1em"></mspace><mn>2</mn><mi>π</mi><mi>x</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>=</mo><mn>2</mn><mi>a</mi><mi>x</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mn>2</mn><mi>x</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mi>y</mi><mo stretchy="false">)</mo><mo>−</mo><msup><mi>e</mi><mi>z</mi></msup><mo data-mjx-texclass="CLOSE">)</mo></mrow></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">