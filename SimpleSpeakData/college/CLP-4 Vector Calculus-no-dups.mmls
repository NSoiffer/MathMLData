<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mfrac><mrow><mi mathvariant="normal">d</mi><mi>s</mi></mrow><mrow><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>t</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><msqrt><mn>1</mn><mo>+</mo><mn>9</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi></msqrt><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.5in"></mspace><mo>=</mo><mfrac><mn>1</mn><mn>18</mn></mfrac><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mn>10</mn></msubsup><msqrt><mi>u</mi></msqrt><mtext> </mtext><mi mathvariant="normal">d</mi><mi>u</mi><mspace width="2em"></mspace><mtext>with </mtext><mi>u</mi><mo>=</mo><mn>1</mn><mo>+</mo><mn>9</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>u</mi><mo>=</mo><mn>18</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.5in"></mspace><mo>=</mo><mfrac><mn>1</mn><mn>18</mn></mfrac><mo minsize="1.623em" maxsize="1.623em">[</mo><mfrac><mn>2</mn><mn>3</mn></mfrac><msup><mi>u</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup><msubsup><mo minsize="1.623em" maxsize="1.623em">]</mo><mn>1</mn><mn>10</mn></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.5in"></mspace><mo>=</mo><mfrac><mn>1</mn><mn>27</mn></mfrac><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>10</mn><msqrt><mn>10</mn></msqrt><mo>−</mo><mn>1</mn><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>π</mi></msubsup><mfrac><mrow><mi mathvariant="normal">d</mi><mi>s</mi></mrow><mrow><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>π</mi></msubsup><mo stretchy="false">|</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo stretchy="false">|</mo><msqrt><mn>1</mn><mo>+</mo><mn>9</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi></msqrt><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="1in"></mspace><mtext>Don't forget the absolute value signs!</mtext></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>2</mn><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mo stretchy="false">|</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo stretchy="false">|</mo><msqrt><mn>1</mn><mo>+</mo><mn>9</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi></msqrt><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>2</mn><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>2</mn></mrow></msubsup><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><msqrt><mn>1</m