<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mtext>Work</mtext></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∫</mo><mi>P</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>4</mn></mrow></msubsup><mi mathvariant="bold">F</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>⋅</mo><mi mathvariant="bold">r</mi><msup><mspace width="0.167em"></mspace><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>4</mn></mrow></msubsup><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><msup><mi>cos</mi><mn>3</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><msubsup><mo minsize="1.623em" maxsize="1.623em">|</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>4</mn></mrow></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo minsize="1.2em" maxsize="1.2em">[</mo><mn>1</mn><mo>−</mo><mfrac><mn>1</mn><msup><mn>2</mn><mrow data-mjx-texclass="ORD"><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mfrac><mo minsize="1.2em" maxsize="1.2em">]</mo><mo>≈</mo><mn>0.2155</mn></mrow></mtd></mtr></mtable></math>
