<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mn>0</mn></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi mathvariant="bold">F</mi><mo>=</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>α</mi><msup><mi>e</mi><mi>y</mi></msup><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mo stretchy="false">(</mo><mi>x</mi><msup><mi>e</mi><mi>y</mi></msup><mo>+</mo><mi>β</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>z</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mi>γ</mi><mi>y</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>z</mi><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo stretchy="false">(</mo><mo>−</mo><mi>γ</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>z</mi><mo>+</mo><mi>β</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>z</mi><mo stretchy="false">)</mo><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mo stretchy="false">(</mo><msup><mi>e</mi><mi>y</mi></msup><mo>−</mo><mi>α</mi><msup><mi>e</mi><mi>y</mi></msup><mo stretchy="false">)</mo><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr></mtable></math>
