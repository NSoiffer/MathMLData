<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msup><mover><mi mathvariant="bold">T</mi><mo stretchy="false">^</mo></mover><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mrow><mo minsize="1.2em" maxsize="1.2em">(</mo><msqrt><mn>2</mn></msqrt><msup><mi>t</mi><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>/</mo><mn>2</mn><mo>,</mo><msqrt><mn>2</mn></msqrt><msup><mi>t</mi><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>/</mo><mn>2</mn><mo>,</mo><mo>−</mo><mn>1</mn><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow><mrow><mn>1</mn><mo>+</mo><mi>t</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mo minsize="1.2em" maxsize="1.2em">(</mo><msqrt><mn>2</mn></msqrt><msup><mi>t</mi><mrow data-mjx-texclass="ORD"><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>,</mo><msqrt><mn>2</mn></msqrt><msup><mi>t</mi><mrow data-mjx-texclass="ORD"><mn>1</mn><mo>/</mo><mn>2</mn></mrow></msup><mo>,</mo><mn>1</mn><mo>−</mo><mi>t</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow><mrow><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>t</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup></mrow></mfrac></mrow></mtd></mtr><mtr><mtd><mrow><msup><mover><mi mathvariant="bold">T</mi><mo stretchy="false">^</mo></mover><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mrow><mo minsize="1.2em" maxsize="1.2em">(</mo><msqrt><mn>2</mn></msqrt><mo>/</mo><mn>2</mn><mo>,</mo><msqrt><mn>2</mn></msqrt><mo>/</mo><mn>2</mn><mo>,</mo><mo>−</mo><mn>1</mn><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow><mn>2</mn></mfrac><mo>−</mo><mfrac><mrow><mo minsize="1.2em" maxsize="1.2em">(</mo><msqrt><mn>2</mn></msqrt><mo>,</mo><