<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>t</mi></mrow></mfrac><mo>×</mo><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>θ</mi></mrow></mfrac></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo data-mjx-texclass="OP" movablelimits="true">det</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mtable columnalign="center" columnspacing="1em" rowspacing="4pt"><mtr><mtd><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mtd></mtr><mtr><mtd><mrow><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></mrow></mtd><mtd><mrow><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></mrow></mtd><mtd><mrow><mi>b</mi><mo>/</mo><mi>a</mi></mrow></mtd></mtr><mtr><mtd><mrow><mo>−</mo><mi>t</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></mrow></mtd><mtd><mrow><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></mrow></mtd><mtd><mn>0</mn></mtd></mtr></mtable><mo data-mjx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mo>−</mo><mfrac><mi>b</mi><mi>a</mi></mfrac><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>,</mo><mo>−</mo><mfrac><mi>b</mi><mi>a</mi></mfrac><mi>t</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>,</mo><mi>t</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>,</mo></mrow></mtd></mtr></mtable></math>
