<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><msub><mo data-mjx-texclass="OP">∮</mo><mrow data-mjx-texclass="ORD"><mi>∂</mi><mi>S</mi></mrow></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mi>a</mi><mi>b</mi></msubsup><mi mathvariant="bold">F</mi><mo minsize="1.623em" maxsize="1.623em">(</mo><mi mathvariant="bold">r</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>u</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>,</mo><mi>v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo minsize="1.623em" maxsize="1.623em">)</mo><mo>⋅</mo><mfrac><mi mathvariant="normal">d</mi><mrow><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mfrac><mi mathvariant="bold">r</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>u</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>,</mo><mi>v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.1in"></mspace><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mi>a</mi><mi>b</mi></msubsup><mi mathvariant="bold">F</mi><mo minsize="1.623em" maxsize="1.623em">(</mo><mi mathvariant="bold">r</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>u</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>,</mo><mi>v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo minsize="1.623em" maxsize="1.623em">)</mo><mo>⋅</mo><mo minsize="1.623em" maxsize="1.623em">[</mo><mfrac><mrow><mi>∂</mi><mi mathvariant="bold">r</mi></mrow><mrow><mi>∂</mi><mi>u</mi></mrow></mfrac><mo