pace width="3.9in"></mspace><mo>+</mo><msup><mi>sin</mi><mn>3</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.623em" maxsize="1.623em">}</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><mn>4</mn><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>4</mn></mrow></msubsup><mi mathvariant="normal">d</mi><mi>φ</mi><mtext> </mtext><msup><mi>sin</mi><mn>3</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mo data-mjx-texclass="CLOSE">]</mo></mrow><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>π</mi></mrow></msubsup><mi mathvariant="normal">d</mi><mi>θ</mi><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>1</mn><mo>+</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo data-mjx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><mn>4</mn><msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mfrac><mrow><msup><mi>sin</mi><mn>4</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi></mrow><mn>4</mn></mfrac><mo data-mjx-texclass="CLOSE">]</mo></mrow><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>4</mn></mrow></msubsup><msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mi>θ</mi><mo>+</mo><mfrac><mrow><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></mrow><mn>2</mn></mfra