ac><mi mathvariant="normal">d</mi><mi>u</mi><mo>+</mo><mfrac><mrow><mi>∂</mi><mi>z</mi></mrow><mrow><mi>∂</mi><mi>v</mi></mrow></mfrac><mi mathvariant="normal">d</mi><mi>v</mi><mo minsize="1.623em" maxsize="1.623em">)</mo><mo>∧</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><mi>x</mi></mrow><mrow><mi>∂</mi><mi>u</mi></mrow></mfrac><mi mathvariant="normal">d</mi><mi>u</mi><mo>+</mo><mfrac><mrow><mi>∂</mi><mi>x</mi></mrow><mrow><mi>∂</mi><mi>v</mi></mrow></mfrac><mi mathvariant="normal">d</mi><mi>v</mi><mo minsize="1.623em" maxsize="1.623em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="1in"></mspace><mo>+</mo><msub><mi>F</mi><mn>3</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><mi>x</mi></mrow><mrow><mi>∂</mi><mi>u</mi></mrow></mfrac><mi mathvariant="normal">d</mi><mi>u</mi><mo>+</mo><mfrac><mrow><mi>∂</mi><mi>x</mi></mrow><mrow><mi>∂</mi><mi>v</mi></mrow></mfrac><mi mathvariant="normal">d</mi><mi>v</mi><mo minsize="1.623em" maxsize="1.623em">)</mo><mo>∧</mo><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><mi>y</mi></mrow><mrow><mi>∂</mi><mi>u</mi></mrow></mfrac><mi mathvariant="normal">d</mi><mi>u</mi><mo>+</mo><mfrac><mrow><mi>∂</mi><mi>y</mi></mrow><mrow><mi>∂</mi><mi>v</mi></mrow></mfrac><mi mathvariant="normal">d</mi><mi>v</mi><mo minsize="1.623em" maxsize="1.623em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.623em" maxsize="1.623em">[</mo><msub><mi>F</mi><mn>1</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><mi>y</mi></mrow><mrow><mi>∂</mi><mi>u</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>z</mi></mrow><mrow><mi>∂</mi><mi>v</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>∂</mi><mi>y</mi></mrow><mrow><mi>∂</mi><mi>v</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>z</mi></mrow><mrow><mi>∂</mi><mi>u</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mo>+</mo><msub><mi>F</mi><mn>2</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><mi>z</mi></mrow><mrow><mi>∂</mi><mi>u</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>x</mi></mrow><mrow><mi>∂</mi><mi>v</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>∂</mi><mi>z</mi></mrow><mrow><mi>∂</mi><mi>v</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>x</mi></mrow><mrow><mi>∂</mi><mi>u</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="1in"></mspace><mo>+</mo><msub><mi>F</mi><mn>3</mn></msub><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>u</mi><mo>,</mo><mi>v</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mrow><mi>∂</mi><mi>x</mi></mrow><mrow><mi>∂</mi><mi>u</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>y</mi></mrow><mrow><mi>∂</mi><mi>v</mi></mrow></mfrac><mo>−</mo><mfrac><mrow><mi>∂</mi><mi>x</mi></mrow><mrow><mi>∂</mi><mi>v</mi></mrow></mfrac><mfrac><mrow><mi>∂</mi><mi>y</mi></mrow><mrow><mi>∂</mi><mi>u</mi></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mo minsize="1.623em" maxsize="1.623em">]</mo><mi mathvariant="