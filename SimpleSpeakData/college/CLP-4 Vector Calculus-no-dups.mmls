<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>S</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><msqrt><mn>3</mn></msqrt></msubsup><mi mathvariant="normal">d</mi><mi>ρ</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>π</mi></msubsup><mi mathvariant="normal">d</mi><mi>φ</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>π</mi></mrow></msubsup><mi mathvariant="normal">d</mi><mi>θ</mi><mtext> </mtext><msup><mi>ρ</mi><mn>4</mn></msup><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mn>2</mn><mi>π</mi><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><msqrt><mn>3</mn></msqrt></msubsup><mi mathvariant="normal">d</mi><mi>ρ</mi><mtext> </mtext><msup><mi>ρ</mi><mn>4</mn></msup><mo data-mjx-texclass="CLOSE">]</mo></mrow><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>π</mi></msubsup><mi mathvariant="normal">d</mi><mi>φ</mi><mtext> </mtext><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>φ</mi><mo data-mjx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mn>2</mn><mi>π</mi><msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mfrac><msup><mi>ρ</mi><mn>5</mn></msup><mn>5</mn></mfrac><mo data-mjx-texclass="CLOSE">]</mo></mrow><mn>0</mn><msqrt><mn>3</mn></msqrt></msubsup><mo minsize="1.623em" maxsize="1.623em">[</mo><