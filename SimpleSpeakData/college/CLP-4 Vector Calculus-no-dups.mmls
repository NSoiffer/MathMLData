<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mi>A</mi></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msub><mo data-mjx-texclass="OP">∮</mo><mi>C</mi></msub><mi>x</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>−</mo><mi>y</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>π</mi></mrow></msubsup><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>x</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><msup><mi>y</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><mo>−</mo><mi>y</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><msup><mi>x</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>π</mi></mrow></msubsup><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>3</mn><msup><mi>cos</mi><mn>4</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>+</mo><mn>3</mn><msup><mi>sin</mi><mn>4</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>θ</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>