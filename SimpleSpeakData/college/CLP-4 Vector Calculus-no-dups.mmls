>+</mo><mn>4</mn></mrow></mfrac><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="1em"></mspace><mrow><mtext>since </mtext><mrow data-mjx-texclass="ORD"><mi>y</mi><mo>=</mo><mn>2</mn></mrow><mtext> on </mtext><mi>L</mi></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn></mrow><mn>1</mn></msubsup><mfrac><mn>4</mn><mrow><mn>4</mn><msup><mi>u</mi><mn>2</mn></msup><mo>+</mo><mn>4</mn></mrow></mfrac><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mspace width="1em"></mspace><mtext>with </mtext><mi>x</mi><mo>=</mo><mn>2</mn><mi>u</mi><mo>,</mo><mi mathvariant="normal">d</mi><mi>x</mi><mo>=</mo><mn>2</mn><mi mathvariant="normal">d</mi><mi>u</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mi>arctan</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>u</mi><msubsup><mo minsize="1.623em" maxsize="1.623em">|</mo><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn></mrow><mn>1</mn></msubsup><mo>=</mo><mo>−</mo><mfrac><mi>π</mi><mn>2</mn></mfrac></mrow></mtd></mtr></mtable></math>
