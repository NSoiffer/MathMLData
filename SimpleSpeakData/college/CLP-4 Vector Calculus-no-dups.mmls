<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>T</mi></msub><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>y</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mtext>Area</mtext><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">)</mo><mo>=</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo stretchy="false">(</mo><mn>4</mn><mo stretchy="false">)</mo><mo stretchy="false">(</mo><mn>1</mn><mo stretchy="false">)</mo><mo>=</mo><mn>2</mn></mrow></mtd></mtr><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>T</mi></msub><mi>y</mi><mtext> </mtext><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>y</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>0</mn><mspace width="2em"></mspace><mrow><mtext>since </mtext><mi>y</mi><mtext> is odd under </mtext></mrow><mi>y</mi><mo stretchy="false">→</mo><mo>−</mo><mi>y</mi></mrow></mtd></mtr><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>T</mi></msub><mi>x</mi><mtext> </mtext><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>y</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi mathvariant="normal">d</mi><mi>x</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>2</mn><mi>x</mi></mrow><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>x</mi></mrow></msubsup><mi mathvariant="normal">d</mi><mi>y</mi><mtext> </mtext><mi>x</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mtext> </mtext><mi mathvariant="normal">d</mi><mi>x</mi><mo>=</mo><mfrac><mn>4</mn><mn>3</mn></mfrac></mrow></mtd></mtr></mtable></math>
