jx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.25in"></mspace><mo>=</mo><mi>x</mi><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mi>z</mi><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr></mtable></math>
<math><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">F</mi><mo>+</mo><mi>λ</mi><mi mathvariant="bold">G</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>=</mo><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><mi>λ</mi><mi>x</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mo stretchy="false">(</mo><mi>z</mi><mo>+</mo><mi>λ</mi><mi>z</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></math>
<math><mrow><mi>λ</mi><mo>=</mo><mo>−</mo><mn>1</mn><mtext>.</mtext></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mi mathvariant="bold">F</mi><mo>−</mo><mi mathvariant="bold">G</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo stretchy="false">(</mo><mn>6</mn><msup><mi>x</mi><mn>2</mn></msup><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup><mo>−</mo><mi>y</mi><mi>z</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mo stretchy="false">(</mo><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup><msup><mi>z</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>y</mi><mo>−</mo><mi>x</mi><mi>z</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mo stretchy="false">(</mo><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup><mi>y</mi><mi>z</mi><mo>−</mo><mi>x</mi><mi>y</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup><mo>−</mo><mi>x</mi><mi>y</mi><mi>z</mi><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr></mtable></math>
<math><mrow><mi mathvariant="bold">F</mi><mo>−</mo><mi mathvariant="bold">G</mi></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi>ϕ</mi></mrow><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>6</mn><msup><mi>x</mi><mn>2</mn></msup><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup><mo>−</mo><mi>y</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi>ϕ</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup><msup><mi>z</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>y</mi><mo>−</mo><mi>x</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mrow><mi>∂</mi><mi>ϕ</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup><mi>y</mi><mi>z</mi><mo>−</mo><mi>x</mi><mi>y</mi></mrow></mtd></mtr></mtable></math>
<math><mrow><mi>ϕ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup><mo>−</mo><mi>x</mi><mi>y</mi><mi>z</mi><mo>+</mo><mi>f</mi><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></math>
<math><mrow><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup><msup><mi>z</mi><mn>2</mn></msup><mo>−</mo><mi>x</mi><mi>z</mi><mo>+</mo><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup><msup><mi>z</mi><mn>2</mn></msup><mo>+</mo><mn>2</mn><mi>y</mi><mo>−</mo><mi>x</mi><mi>z</mi><mspace width="2em"></mspace><mtext>or</mtext><mspace width="2em"></mspace><mfrac><mrow><mi>∂</mi><mi>f</mi></mrow><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mn>2</mn><mi>y</mi></mrow></math>
<math><mrow><mi>f</mi><mo stretchy="false">(</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><msup><mi>y</mi><mn>2</mn></msup><mo>+</mo><mi>g</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></math>
<math><mrow><mi>ϕ</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mn>2</mn><msup><mi>x</mi><mn>3</mn></msup><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup><mo>−</mo><mi>x</mi><mi>y</mi><mi>z</mi><mo>+</mo><msup><mi>y</mi><mn>2</mn></msup><mo>+</mo><mi>g</mi><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></math>
<math><mrow><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup><mi>y</mi><mi>z</mi><mo>−</mo><mi>x</mi><mi>y</mi><mo>+</mo><msup><mi>g</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mn>4</mn><msup><mi>x</mi><mn>3</mn></msup><mi>y</mi><mi>z</mi><mo>−</mo><mi>x</mi><mi>y</mi><mspace width="2em"></mspace><mtext>or</mtext><mspace width="2em"></mspace><msup><mi>g</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mn>0</mn></mrow></math>
