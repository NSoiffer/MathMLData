<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>S</mi></msub><msqrt><mn>1</mn><mo>+</mo><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi></msqrt><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>π</mi></msubsup><mi mathvariant="normal">d</mi><mi>y</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>π</mi></mrow></msubsup><mi mathvariant="normal">d</mi><mi>θ</mi><mtext> </mtext><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mo minsize="1.2em" maxsize="1.2em">{</mo><mn>1</mn><mo>+</mo><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mo minsize="1.2em" maxsize="1.2em">}</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>2</mn><mi>π</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>π</mi></msubsup><mi mathvariant="normal">d</mi><mi>y</mi><mtext> </mtext><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mo minsize="1.2em" maxsize="1.2em">{</mo><mn>1</mn><mo>+</mo><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mo minsize="1.2em" maxsize="1.2em">}</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mn>2</mn><mi>π</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn></mrow></msubsup><mi mathvariant="normal">d</mi><mi>u</mi><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">{</mo><mn>1</mn><mo>+</mo><msup><mi>u</mi><mn>2</mn></msup><mo minsize="1.2em" maxsize="1.2em">}</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mspace width="1in"></mspace><mtext>with </mtext><mi>u</mi><mo>=</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>