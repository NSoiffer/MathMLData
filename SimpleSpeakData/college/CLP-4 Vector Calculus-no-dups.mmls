>⟹</mo><mspace width="0.278em"></mspace><mspace width="1em"></mspace><msub><mi>θ</mi><mn>2</mn></msub><mo>=</mo><mfrac><mi>π</mi><mn>4</mn></mfrac><mrow><mtext> as </mtext><mrow data-mjx-texclass="ORD"><mo stretchy="false">(</mo><msub><mi>x</mi><mn>2</mn></msub><mo>,</mo><msub><mi>y</mi><mn>2</mn></msub><mo stretchy="false">)</mo></mrow><mtext> is in the first octant</mtext></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>3</mn></msub><mo>,</mo><msub><mi>y</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd><mtd/><mtd><mrow><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mspace width="1em"></mspace><msub><mi>r</mi><mn>3</mn></msub><mo>=</mo><mn>1</mn><mo>,</mo><mtext> </mtext><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><msub><mi>θ</mi><mn>3</mn></msub><mo>=</mo><mn>0</mn></mrow></mtd></mtr><mtr><mtd/><mtd/><mtd/><mtd><mrow><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mspace width="1em"></mspace><msub><mi>θ</mi><mn>3</mn></msub><mo>=</mo><mfrac><mi>π</mi><mn>2</mn></mfrac><mrow><mtext> as </mtext><mrow data-mjx-texclass="ORD"><mo stretchy="false">(</mo><msub><mi>x</mi><mn>3</mn></msub><mo>,</mo><msub><mi>y</mi><mn>3</mn></msub><mo stretchy="false">)</mo></mrow><mtext> is on the positive </mtext><mi>y</mi><mtext>-axis</mtext></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>4</mn></msub><mo>,</mo><msub><mi>y</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo stretchy="false">(</mo><mo>−</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd><mtd/><mtd><mrow><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mspace width="1em"></mspace><msub><mi>r</mi><mn>4</mn></msub><mo>=</mo><msqrt><mn>2</mn></msqrt><mo>,</mo><mtext> </mtext><mi>tan</mi><mo data-mjx-texclass="NONE">⁡</mo><msub><mi>θ</mi><mn>4</mn></msub><mo>=</mo><mo>−</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd/><mtd/><mtd/><mtd><mrow><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mspace width="1em"></mspace><msub><mi>θ</mi><mn>4</mn></msub><mo>=</mo><mfrac><mrow><mn>3</mn><mi>π</mi></mrow><mn>4</mn></mfrac><mrow><mtext> as </mtext><mrow data-mjx-texclass="ORD"><mo stretchy="false">(</mo><msub><mi>x</mi><mn>4</mn></msub><mo>,</mo><msub><mi>y</mi><mn>4</mn></msub><mo stretchy="false">)</mo></mrow><mtext> is in the third octant</mtext></mrow></mrow></mtd></mtr><mtr><mtd><mrow><mo stretchy="false">(</mo><msub><mi>x</mi><mn>5</mn></msub><mo>,</mo><msub><mi>y</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo stretchy="false">(</mo><mo>−</mo><mn>2</mn><mo>,</mo><mn>0</mn><mo stretchy="false">)</mo></mrow></mtd><mtd/><mtd><mrow><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mspace width="1em"></mspace><msub><mi>r</mi><mn>5</mn></msub><mo>=</mo><mn>2</mn><mo>,</mo><mtext> </mtext><mi>tan</mi><mo data-mjx-texclass="NONE">⁡</mo><msub><mi>θ</mi><mn>5</mn></msub><mo>=</mo><mn>0</mn></mrow></mtd></mtr><mtr><mtd/><mtd/><mtd/><mtd><mrow><mspace width="0.278em"></mspace><mo stretchy="false">⟹</mo><mspace width="0.278em"></mspace><mspace width="1em"></mspace><msub><mi>θ</mi><mn>5</mn></msub><mo>=</mo><mi>π</mi><mrow><mtext> as </mtext><mrow data-mjx-texclass="ORD"><mo stretchy="false">(</mo><msub><mi>x</mi><mn>5</mn></msub><mo>,</mo><msub><mi>y</mi><mn>5</mn></msub><mo stretchy="false">)</mo></mrow><mtext> is on the negative </mtext><mi>x</mi><mtext>-axis</mtext></mrow></mrow></mtd></mtr></mtable></math>
