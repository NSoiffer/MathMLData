<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mi>f</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>=</mo><mi>f</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><mo stretchy="false">(</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>=</mo><mi>f</mi><mo stretchy="false">(</mo><mi>π</mi><mo>,</mo><mn>1</mn><mo>,</mo><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mo>−</mo><mi>f</mi><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">[</mo><mi>π</mi><msup><mi>e</mi><mi>π</mi></msup><mo>−</mo><mn>1</mn><mo minsize="1.2em" maxsize="1.2em">]</mo><mo>−</mo><mo minsize="1.2em" maxsize="1.2em">[</mo><mn>1</mn><mo minsize="1.2em" maxsize="1.2em">]</mo><mo>=</mo><mi>π</mi><msup><mi>e</mi><mi>π</mi></msup><mo>−</mo><mn>2</mn></mrow></mtd></mtr></mtable></math>
<math><mrow><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mo stretchy="false">(</mo><mi>x</mi><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo><mi>y</mi><msup><mi>e</mi><mi>x</mi></msup><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>+</mo><mo stretchy="false">(</mo><mi>x</mi><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><msup><mi>z</mi><mn>3</mn></msup><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>y</mi><mo>+</mo><mn>3</mn><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>z</mi></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mi>I</mi></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi><mo>+</mo><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>π</mi><msup><mi>e</mi><mi>π</mi></msup><mo>−</mo><mn>2</mn><mo>+</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>π</mi></msubsup><mover><mover><mrow><mo stretchy="false">(</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mn>2</mn><mi>t</mi><mo stretchy="false">)</mo></mrow><mo>⏞</mo></mover><mi>y</mi></mover><mover><mover><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi></mrow><mo>⏞</mo></mover><msup><mi>z</mi><mn>2</mn></msup></mover><mover><mover><mrow><mo stretchy="false">(</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>t</mi></mrow><mo>⏞</mo></mover><mrow data-mjx-texclass="ORD"><mi mathvariant="normal">d</mi><mi>z</mi></mrow></mover></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>π</mi><msup><mi>e</mi><mi>π</mi></msup><mo>−</mo><mn>2</mn><mo>+</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mi>π</mi></msubsup><mo stretchy="false">(</mo><mn>2</mn><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo stretchy="false">(</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>π</mi><msup><mi>e</mi><mi>π</mi></msup><mo>−</mo><mn>2</mn><mo>+</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn></mrow></msubsup><mo stretchy="false">(</mo><mn>2</mn><msup><mi>u</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><msup><mi>u</mi><mn>2</mn></msup><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>u</mi><mspace width="2em"></mspace><mtext>with </mtext><mi>u</mi><mo>=</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo>,</mo><mtext> </mtext><mi mathvariant="normal">d</mi><mi>u</mi><mo>=</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>π</mi><msup><mi>e</mi><mi>π</mi></msup><mo>−</mo><mn>2</mn><mo>+</mo><mo minsize="1.623em" maxsize="1.623em">[</mo><mfrac><mrow><mn>2</mn><msup><mi>u</mi><mn>5</mn></msup></mrow><mn>5</mn></mfrac><mo>−</mo><mfrac><msup><mi>u</mi><mn>3</mn></msup><mn>3</mn></mfrac><msubsup><mo minsize="1.623em" maxsize="1.623em">]</mo><mn>1</mn><mrow data-mjx-texclass="ORD"><mo>−</mo><mn>1</mn></mrow></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>π</mi><msup><mi>e</mi><mi>π</mi></msup><mo>−</mo><mn>2</mn><mo>+</mo><mo minsize="1.623em" maxsize="1.623em">[</mo><mo>−</mo><mfrac><mn>4</mn><mn>5</mn></mfrac><mo>+</mo><mfrac><mn>2</mn><mn>3</mn></mfrac><mo minsize="1.623em" maxsize="1.623em">]</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>π</mi><msup><mi>e</mi><mi>π</mi></msup><mo>−</mo><mfrac><mn>32</mn><mn>15</mn></mfrac></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mn mathvariant="bold">0</mn></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi mathvariant="bold">F</mi><mo>=</mo><mo data-mjx-texclass="OP" movablelimits="true">det</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">|</mo><mtable columnalign="center" columnspacing="1em" rowspacing="4pt"><mtr><mtd><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mtd></mtr><mtr><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac></mtd><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac></mtd><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac></mtd></mtr><mtr><mtd><mrow><msup><mi>y</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>+</mo><mi>A</mi><mi>x</mi><msup><mi>y</mi><mn>3</mn></msup></mrow></mtd><mtd><mrow><mn>2</mn><mi>x</mi><mi>y</mi><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>+</mo><mn>3</mn><msup><mi>x</mi><mn>2</mn></msup><msup><mi>y</mi><mn>2</mn></msup></mrow></mtd><mtd><mrow><mi>B</mi><mi>x</mi><msup><mi>y</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup></mrow></mtd></mtr></mtable><mo data-mjx-texclass="CLOSE">|</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>2</mn><mi>B</mi><mi>x</mi><mi>y</mi><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>−</mo><mn>6</mn><mi>x</mi><mi>y</mi><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>B</mi><msup><mi>y</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>−</mo><mn>3</mn><msup><mi>y</mi><mn>2</mn></msup><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="1in"></mspace><mo>+</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>2</mn><mi>y</mi><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>+</mo><mn>6</mn><mi>x</mi><msup><mi>y</mi><mn>2</mn></msup><mo>−</mo><mn>2</mn><mi>y</mi><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>3</mn><mi>z</mi></mrow></msup><mo>−</mo><mn>3</mn><mi>A</mi><mi>x</mi><msup><mi>y</mi><mn>2</mn></msup><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr></mtable></math>
