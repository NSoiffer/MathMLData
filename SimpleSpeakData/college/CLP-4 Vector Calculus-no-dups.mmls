<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>t</mi><mo>+</mo><mn>2</mn><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mn>1</mn><mo>−</mo><mi>t</mi><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><msup><mi>t</mi><mn>2</mn></msup><mo>/</mo><mn>2</mn><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mi mathvariant="bold">v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>=</mo><msup><mi mathvariant="bold">r</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>1</mn><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mo>−</mo><mn>1</mn><mspace width="0.167em"></mspace><mo>,</mo><mspace width="0.167em"></mspace><mi>t</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr><mtr><mtd><mrow><mfrac><mrow><mi mathvariant="normal">d</mi><mi>s</mi></mrow><mrow><mi mathvariant="normal">d</mi><mi>t</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>=</mo><mo stretchy="false">|</mo><mi mathvariant="bold">v</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo stretchy="false">|</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msqrt><mn>2</mn><mo>+</mo><msup><mi>t</mi><mn>2</mn></msup></msqrt></mrow></mtd></mtr><mtr><mtd><mrow><mi mathvariant="bold">a</mi><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo><mo>=</mo><msup><mi mathvariant="bold">v</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretch