<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>x</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><mo>=</mo><mn>3</mn><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>,</mo><mtext> </mtext><mi>y</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><mo>=</mo><mn>3</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>,</mo><mtext> </mtext><mi>z</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><mo>=</mo><mn>2</mn><mi>x</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><mo>+</mo><mn>3</mn><mi>y</mi><mo stretchy="false">(</mo><mi>θ</mi><mo stretchy="false">)</mo><mo>=</mo><mn>6</mn><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>+</mo><mn>9</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mn>0</mn><mo>≤</mo><mi>θ</mi><mo>≤</mo><mn>2</mn><mi>π</mi></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mfrac><mrow><mi mathvariant="normal">d</mi><mi>s</mi></mrow><mrow><mi mathvariant="normal">d</mi><mi>θ</mi></mrow></mfrac></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msqrt><msup><mi>x</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>θ</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo>+</mo><msup><mi>y</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>θ</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>θ</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup></msqrt></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msqrt><mn>9</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>+</mo><mn>9</mn><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>+</mo><mn>36</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>+</mo><mn>81</mn><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>−</mo><mn>108</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></msqrt></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msqrt><mn>45</mn><mo>+</mo><mn>45</mn><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>−</mo><mn>108</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></msqrt></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msup><mi mathvariant="bold">r</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><mi>t</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mn>3</mn><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mo>−</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mn>3</mn><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>t</mi><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover><mo minsize="1.2em" maxsize