<math><mrow><mi>f</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>y</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mi>x</mi><mi>y</mi><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><mi>y</mi><msup><mi>z</mi><mn>3</mn></msup><mo>+</mo><mi>g</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo></mrow></math>
<math><mrow><mn>3</mn><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup><mo>+</mo><mfrac><mrow><mi>∂</mi><mi>g</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mn>3</mn><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup><mspace width="2em"></mspace><mtext>or</mtext><mspace width="2em"></mspace><mfrac><mrow><mi>∂</mi><mi>g</mi></mrow><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mn>0</mn></mrow></math>
<math><mrow><mi>g</mi><mo stretchy="false">(</mo><mi>x</mi><mo>,</mo><mi>z</mi><mo stretchy="false">)</mo><mo>=</mo><mi>h</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo></mrow></math>
