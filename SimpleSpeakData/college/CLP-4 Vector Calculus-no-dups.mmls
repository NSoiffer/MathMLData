<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><msub><mi>S</mi><mi>s</mi></msub></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mover><mi mathvariant="bold">n</mi><mo stretchy="false">^</mo></mover><mtext> </mtext><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>π</mi></mrow></msubsup><mi mathvariant="normal">d</mi><mi>θ</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>5</mn></msubsup><mi mathvariant="normal">d</mi><mi>z</mi><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">{</mo><mn>9</mn><mo>+</mo><mfrac><mn>3</mn><mn>2</mn></mfrac><mspace width="0.167em"></mspace><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mn>2</mn><mi>θ</mi><mo stretchy="false">)</mo><mo>+</mo><mn>3</mn><mi>z</mi><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo minsize="1.2em" maxsize="1.2em">}</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>9</mn><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>π</mi></mrow></msubsup><mi mathvariant="normal">d</mi><mi>θ</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>5</mn></msubsup><mi mathvariant="normal">d</mi><mi>z</mi><mspace width="1em"></mspace><mtext>since </mtext><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>π</mi></mrow></msubsup><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>θ</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>π</mi></mrow></msubsup><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mn>2</mn><mi>θ</mi><mo stretchy="false