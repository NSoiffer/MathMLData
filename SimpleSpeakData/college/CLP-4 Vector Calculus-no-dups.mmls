<math><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mo stretchy="false">(</mo><mi>y</mi><mo>−</mo><mn>1</mn><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo>≤</mo><mn>1</mn></mrow></math>
<math><mrow><mn>0</mn><mo>≤</mo><mi>z</mi><mo>≤</mo><msup><mi>y</mi><mn>2</mn></msup><mtext>;</mtext></mrow></math>
