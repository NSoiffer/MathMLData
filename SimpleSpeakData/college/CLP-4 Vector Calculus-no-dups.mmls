<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∬</mo><mi>S</mi></msub><msup><mi>y</mi><mn>3</mn></msup><mtext> </mtext><mi mathvariant="normal">d</mi><mi>S</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msub><mo data-mjx-texclass="OP">∬</mo><mrow data-mjx-texclass="ORD"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup><mo>≤</mo><mn>1</mn></mrow></msub><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>z</mi><mtext> </mtext><mfrac><msqrt><mn>2</mn></msqrt><msqrt><mn>2</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup></msqrt></mfrac><mover><mover><mrow><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>2</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup><msup><mo minsize="1.2em" maxsize="1.2em">)</mo><mrow data-mjx-texclass="ORD"><mn>3</mn><mo>/</mo><mn>2</mn></mrow></msup></mrow><mo>⏞</mo></mover><msup><mi>y</mi><mn>3</mn></msup></mover></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msqrt><mn>2</mn></msqrt><msub><mo data-mjx-texclass="OP">∬</mo><mrow data-mjx-texclass="ORD"><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><msup><mi>z</mi><mn>2</mn></msup><mo>≤</mo><mn>1</mn></mrow></msub><mi mathvariant="normal">d</mi><mi>x</mi><mi mathvariant="normal">d</mi><mi>z</mi><mtext> </mtext><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>2</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><msup><mi>z</mi><mn>2</mn></msup><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd></mtr></mtable></math>
