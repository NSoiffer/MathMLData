<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mo stretchy="false">(</mo><mi>ω</mi><mspace width="1px"></mspace><mi>ω</mi><mo>×</mo><mi mathvariant="bold">r</mi><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo data-mjx-texclass="OP" movablelimits="true">det</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mtable columnalign="center" columnspacing="1em" rowspacing="4pt"><mtr><mtd><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mtd></mtr><mtr><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac></mtd><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac></mtd><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac></mtd></mtr><mtr><mtd><mrow><msub><mi>ω</mi><mn>2</mn></msub><mi>z</mi><mo>−</mo><msub><mi>ω</mi><mn>3</mn></msub><mi>y</mi></mrow></mtd><mtd><mrow><mo>−</mo><msub><mi>ω</mi><mn>1</mn></msub><mi>z</mi><mo>+</mo><msub><mi>ω</mi><mn>3</mn></msub><mi>x</mi></mrow></mtd><mtd><mrow><msub><mi>ω</mi><mn>1</mn></msub><mi>y</mi><mo>−</mo><msub><mi>ω</mi><mn>2</mn></msub><mi>x</mi></mrow></mtd></mtr></mtable><mo data-mjx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>2</mn><msub><mi>ω</mi><mn>1</mn></msub><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mn>2</mn><msub><mi>ω</mi><mn>2</mn></msub><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mn>2</