<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msub><mo data-mjx-texclass="OP">∫</mo><mi>C</mi></msub><mi mathvariant="bold">F</mi><mo>⋅</mo><mi mathvariant="normal">d</mi><mi mathvariant="bold">r</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>φ</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>−</mo><mi>φ</mi><mo minsize="1.2em" maxsize="1.2em">(</mo><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo><mo minsize="1.2em" maxsize="1.2em">)</mo><mo>=</mo><mo minsize="1.623em" maxsize="1.623em">[</mo><mi>x</mi><mi>z</mi><mo>+</mo><mi>x</mi><msup><mi>e</mi><mi>y</mi></msup><mo>+</mo><msup><mi>e</mi><mi>z</mi></msup><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mo>+</mo><mi>z</mi><msubsup><mo minsize="1.623em" maxsize="1.623em">]</mo><mrow data-mjx-texclass="ORD"><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow data-mjx-texclass="ORD"><mi mathvariant="bold">r</mi><mo stretchy="false">(</mo><mi>π</mi><mo stretchy="false">)</mo></mrow></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.623em" maxsize="1.623em">[</mo><mi>x</mi><mi>z</mi><mo>+</mo><mi>x</mi><msup><mi>e</mi><mi>y</mi></msup><mo>+</mo><msup><mi>e</mi><mi>z</mi></msup><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>y</mi><mo>+</mo><mi>z</mi><msubsup><mo minsize="1.623em" maxsize="1.623em">]</mo><mrow data-mjx-texclass="ORD"><mo stretchy="false">(</mo><mn>0</mn><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow><mrow data-mjx-texclass="ORD"><mo stretchy="false">(</mo><msup><mi>π</mi><mn>2</mn></msup><mo>,</mo><mn>0</mn><mo>,</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><msup><mi>π</mi><mn>2</mn></msup><mo>+</mo><msup><mi>π</mi><mn>2</mn></msup><mo>+</mo><mi>e</mi><mo>+</mo><mn>1</mn><mo data-mjx-texclass="CLOSE">)</mo></mrow><mo>−</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mn>0</mn><mo>+</mo><mn>0</mn><mo>+</mo><mi>e</mi><mo>+</mo><mn>1</mn><mo data-mjx-texclass="CLOSE">)</mo></mrow><mo>=</mo><mn>2</mn><msup><mi>π</mi><mn>2</mn></msup></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mn mathvariant="bold">0</mn><mo>=</mo><mrow><mi mathvariant="normal">∇</mi><mspace width="1px"></mspace><mi mathvariant="normal">∇</mi></mrow><mo>×</mo><mi mathvariant="bold">F</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo data-mjx-texclass="OP" movablelimits="true">det</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mtable columnalign="center" columnspacing="1em" rowspacing="4pt"><mtr><mtd><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover></mtd><mtd><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mtd></mtr><mtr><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>x</mi></mrow></mfrac></mtd><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>y</mi></mrow></mfrac></mtd><mtd><mfrac><mi>∂</mi><mrow><mi>∂</mi><mi>z</mi></mrow></mfrac></mtd></mtr><mtr><mtd><mrow><mo stretchy="false">(</mo><mi>x</mi><mo>−</mo><mi>a</mi><mo stretchy="false">)</mo><mi>y</mi><msup><mi>e</mi><mi>x</mi></msup></mrow></mtd><mtd><mrow><mi>x</mi><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><msup><mi>z</mi><mn>3</mn></msup></mrow></mtd><mtd><mrow><mi>b</mi><mi>y</mi><msup><mi>z</mi><mn>2</mn></msup></mrow></mtd></mtr></mtable><mo data-mjx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mi>b</mi><msup><mi>z</mi><mn>2</mn></msup><mo>−</mo><mn>3</mn><msup><mi>z</mi><mn>2</mn></msup><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ı</mi><mspace width="1px"></mspace><mi>ı</mi></mrow><mo stretchy="false">^</mo></mover><mo>−</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><mn>0</mn><mo>−</mo><mn>0</mn><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mover><mrow><mi>ȷ</mi><mspace width="1px"></mspace><mi>ȷ</mi></mrow><mo stretchy="false">^</mo></mover><mo>+</mo><mo minsize="1.2em" maxsize="1.2em">(</mo><msup><mi>e</mi><mi>x</mi></msup><mo>+</mo><mi>x</mi><msup><mi>e</mi><mi>x</mi></msup><mo>−</mo><mo stretchy="false">(</mo><mi>x</mi><mo>−</mo><mi>a</mi><mo stretchy="false">)</mo><msup><mi>e</mi><mi>x</mi></msup><mo minsize="1.2em" maxsize="1.2em">)</mo><mspace width="0.167em"></mspace><mover><mi mathvariant="bold">k</mi><mo stretchy="false">^</mo></mover></mrow></mtd></mtr></mtable></math>
