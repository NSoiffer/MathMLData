<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mi>V</mi><mo stretchy="false">(</mo><msub><mi>r</mi><mn>0</mn></msub><mo>+</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><mo stretchy="false">)</mo><mo>−</mo><mi>V</mi><mo stretchy="false">(</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>4</mn><mn>3</mn></mfrac><mi>π</mi><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><msubsup><mi>r</mi><mn>0</mn><mn>3</mn></msubsup><mo>+</mo><mn>3</mn><msubsup><mi>r</mi><mn>0</mn><mn>2</mn></msubsup><mi mathvariant="normal">Δ</mi><mi>r</mi><mo>+</mo><mn>3</mn><msub><mi>r</mi><mn>0</mn></msub><mspace width="0.167em"></mspace><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><msup><mo stretchy="false">)</mo><mn>3</mn></msup><mo data-mjx-texclass="CLOSE">]</mo></mrow><mo>−</mo><mfrac><mn>4</mn><mn>3</mn></mfrac><mi>π</mi><msubsup><mi>r</mi><mn>0</mn><mn>3</mn></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>4</mn><mn>3</mn></mfrac><mi>π</mi><mo stretchy="false">[</mo><mn>3</mn><msubsup><mi>r</mi><mn>0</mn><mn>2</mn></msubsup><mi mathvariant="normal">Δ</mi><mi>r</mi><mo>+</mo><mn>3</mn><msub><mi>r</mi><mn>0</mn></msub><mspace width="0.167em"></mspace><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><msup><mo stretchy="false">)</mo><mn>3</mn></msup><mo stretchy="false">]</mo></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnspacing="1em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mfrac><mn>4</mn><mn>3</mn></mfrac><mi>π</mi><mo minsize="1.2em" maxsize="1.2em">|</mo><mn>3</mn><msub><mi>r</mi><mn>0</mn></msub><mspace width="0.167em"></mspace><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><msup><mo stretchy="false">)</mo><mn>3</mn></msup><mo minsize="1.2em" maxsize="1.2em">|</mo><mo>=</mo><mfrac><mn>4</mn><mn>3</mn></mfrac><mi>π</mi><mo minsize="1.2em" maxsize="1.2em">|</mo><mn>3</mn><msub><mi>r</mi><mn>0</mn></msub><mo>+</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><mo minsize="1.2em" maxsize="1.2em">|</mo><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mn>100</mn><mo>⋅</mo><mfrac><mn>1</mn><mrow><mfrac><mn>4</mn><mn>3</mn></mfrac><mi>π</mi><msubsup><mi>r</mi><mn>0</mn><mn>3</mn></msubsup></mrow></mfrac><mo>⋅</mo><mfrac><mn>4</mn><mn>3</mn></mfrac><mi>π</mi><mo minsize="1.2em" maxsize="1.2em">|</mo><mn>3</mn><msub><mi>r</mi><mn>0</mn></msub><mspace width="0.167em"></mspace><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo>+</mo><mo stretchy="false">(</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><msup><mo stretchy="false">)</mo><mn>3</mn></msup><mo minsize="1.2em" maxsize="1.2em">|</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mn>100</mn><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">|</mo><mn>3</mn><mfrac><mrow><mi mathvariant="normal">Δ</mi><msup><mi>r</mi><mn>2</mn></msup></mrow><msubsup><mi>r</mi><mn>0</mn><mn>2</mn></msubsup></mfrac><mo>+</mo><mfrac><mrow><mi mathvariant="normal">Δ</mi><msup><mi>r</mi><mn>3</mn></msup></mrow><msubsup><mi>r</mi><mn>0</mn><mn>3</mn></msubsup></mfrac><mo data-mjx-texclass="CLOSE">|</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mn>100</mn><mfrac><mrow><mn>3</mn><mi mathvariant="normal">Δ</mi><mi>r</mi></mrow><msub><mi>r</mi><mn>0</mn></msub></mfrac><mo data-mjx-texclass="CLOSE">)</mo></mrow><mo>⋅</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mfrac><mrow><mi mathvariant="normal">Δ</mi><mi>r</mi></mrow><msub><mi>r</mi><mn>0</mn></msub></mfrac><mo data-mjx-texclass="CLOSE">)</mo></mrow><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">|</mo><mn>1</mn><mo>+</mo><mfrac><mrow><mi mathvariant="normal">Δ</mi><mi>r</mi></mrow><mrow><mn>3</mn><msub><mi>r</mi><mn>0</mn></msub></mrow></mfrac><mo data-mjx-texclass="CLOSE">|</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>≤</mo><mn>3</mn><mi>ε</mi><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mfrac><mi>ε</mi><mn>100</mn></mfrac><mo data-mjx-texclass="CLOSE">)</mo></mrow><mo>⋅</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mn>1</mn><mo>+</mo><mfrac><mi>ε</mi><mn>300</mn></mfrac><mo data-mjx-texclass="CLOSE">)</mo></mrow></mrow></mtd></mtr></mtable></math>
