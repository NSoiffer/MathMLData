<math><mtable displaystyle="true" columnspacing="1em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mn>100</mn><mfrac><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Δ</mi><mi>A</mi><mo stretchy="false">|</mo></mrow><mrow><mi>A</mi><mo stretchy="false">(</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac><mo>≈</mo><mn>100</mn><mfrac><mrow><mo stretchy="false">|</mo><msup><mi>A</mi><mo data-mjx-alternate="1">′</mo></msup><mo stretchy="false">(</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">)</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><mo stretchy="false">|</mo></mrow><mrow><mi>A</mi><mo stretchy="false">(</mo><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">)</mo></mrow></mfrac><mo>=</mo><mn>100</mn><mfrac><mrow><mn>8</mn><mi>π</mi><msub><mi>r</mi><mn>0</mn></msub><mo stretchy="false">|</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><mo stretchy="false">|</mo></mrow><mrow><mn>4</mn><mi>π</mi><msubsup><mi>r</mi><mn>0</mn><mn>2</mn></msubsup></mrow></mfrac><mo>=</mo><mn>2</mn><mo>×</mo><mn>100</mn><mfrac><mrow><mo stretchy="false">|</mo><mi mathvariant="normal">Δ</mi><mi>r</mi><mo stretchy="false">|</mo></mrow><msub><mi>r</mi><mn>0</mn></msub></mfrac><mo>≤</mo><mn>2</mn><mi>ε</mi></mrow></mtd></mtr></mtable></math>
