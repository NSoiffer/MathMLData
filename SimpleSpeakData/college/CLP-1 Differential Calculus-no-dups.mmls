<math><mrow><mfrac><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn></msqrt><mi>x</mi></mfrac><mo>=</mo><mo>−</mo><msqrt><mfrac><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn></mrow><msup><mi>x</mi><mn>2</mn></msup></mfrac></msqrt><mo>=</mo><mo>−</mo><msqrt><mn>1</mn><mo>+</mo><mfrac><mn>5</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac></msqrt><mo>.</mo></mrow></math>
<math><mrow><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>x</mi><mo accent="false" stretchy="false">→</mo><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mn>3</mn><mi>x</mi><mo>+</mo><mn>5</mn></mrow><mrow><msqrt><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn></msqrt><mo>−</mo><mi>x</mi></mrow></mfrac><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>x</mi><mo accent="false" stretchy="false">→</mo><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mn>3</mn><mo>+</mo><mfrac><mn>5</mn><mi>x</mi></mfrac></mrow><mrow><mo>−</mo><msqrt><mn>1</mn><mo>+</mo><mfrac><mn>5</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac></msqrt><mo>−</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mfrac><mn>3</mn><mrow><mo>−</mo><mn>1</mn><mo>−</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mo>−</mo><mfrac><mn>3</mn><mn>2</mn></mfrac><mo>.</mo></mrow></math>
<math><mrow><mfrac><msqrt><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>15</mn></msqrt><mi>x</mi></mfrac><mo>=</mo><mfrac><msqrt><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>15</mn></msqrt><mrow><mo>−</mo><msqrt><msup><mi>x</mi><mn>2</mn></msup></msqrt></mrow></mfrac><mo>=</mo><mo>−</mo><msqrt><mfrac><mrow><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>15</mn></mrow><msup><mi>x</mi><mn>2</mn></msup></mfrac></msqrt><mo>=</mo><mo>−</mo><msqrt><mn>4</mn><mo>+</mo><mfrac><mn>15</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac></msqrt><mo>.</mo></mrow></math>
<math><mrow><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>x</mi><mo accent="false" stretchy="false">→</mo><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mn>5</mn><mi>x</mi><mo>+</mo><mn>7</mn></mrow><mrow><msqrt><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>15</mn></msqrt><mo>−</mo><mi>x</mi></mrow></mfrac><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>x</mi><mo accent="false" stretchy="false">→</mo><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mn>5</mn><mo>+</mo><mfrac><mn>7</mn><mi>x</mi></mfrac></mrow><mrow><mo>−</mo><msqrt><mn>4</mn><mo>+</mo><mfrac><mn>15</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac></msqrt><mo>−</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mfrac><mn>5</mn><mrow><mo>−</mo><mn>2</mn><mo>−</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mo>−</mo><mfrac><mn>5</mn><mn>3</mn></mfrac><mo>.</mo></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>x</mi><mo stretchy="false">→</mo><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mn>3</mn><msup><mi>x</mi><mn>7</mn></msup><mo>+</mo><msup><mi>x</mi><mn>5</mn></msup><mo>−</mo><mn>15</mn></mrow><mrow><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>32</mn><mi>x</mi></mrow></mfrac></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>x</mi><mo stretchy="false">→</mo><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><msup><mi>x</mi><mn>2</mn></msup><mo stretchy="false">(</mo><mn>3</mn><msup><mi>x</mi><mn>5</mn></msup><mo>+</mo><msup><mi>x</mi><mn>3</mn></msup><mo>−</mo><mfrac><mn>15</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac><mo stretchy="false">)</mo></mrow><mrow><msup><mi>x</mi><mn>2</mn></msup><mo stretchy="false">(</mo><mn>4</mn><mo>+</mo><mfrac><mn>32</mn><mi>x</mi></mfrac><mo stretchy="false">)</mo></mrow></mfrac></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>x</mi><mo stretchy="false">→</mo><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mn>3</mn><msup><mi>x</mi><mn>5</mn></msup><mo>+</mo><msup><mi>x</mi><mn>3</mn></msup><mo>−</mo><mfrac><mn>15</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac></mrow><mrow><mn>4</mn><mo>+</mo><mfrac><mn>32</mn><mi>x</mi></mfrac></mrow></mfrac></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>x</mi><mo stretchy="false">→</mo><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mn>3</mn><mo stretchy="false">(</mo><mo>−</mo><mi>x</mi><msup><mo stretchy="false">)</mo><mn>5</mn></msup><mo>+</mo><mo stretchy="false">(</mo><mo>−</mo><mi>x</mi><msup><mo stretchy="false">)</mo><mn>3</mn></msup><mo>−</mo><mfrac><mn>15</mn><mrow><mo stretchy="false">(</mo><mo>−</mo><mi>x</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup></mrow></mfrac></mrow><mrow><mn>4</mn><mo>+</mo><mfrac><mn>32</mn><mrow><mo>−</mo><mi>x</mi></mrow></mfrac></mrow></mfrac></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mrow><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>x</mi><mo stretchy="false">→</mo><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mo>−</mo><mn>3</mn><msup><mi>x</mi><mn>5</mn></msup><mo>−</mo><msup><mi>x</mi><mn>3</mn></msup><mo>−</mo><mfrac><mn>15</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac></mrow><mrow><mn>4</mn><mo>−</mo><mfrac><mn>32</mn><mi>x</mi></mfrac></mrow></mfrac></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mtd></mtr></mtable></math>
<math><mrow><mo minsize="1.2em" maxsize="1.2em">(</mo><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>n</mi></msqrt><mo>+</mo><mi>n</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mtext>.</mtext></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mo minsize="1.2em" maxsize="1.2em">(</mo><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>n</mi></msqrt><mo>−</mo><mi>n</mi><mo minsize="1.2em" maxsize="1.2em">)</mo></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>n</mi><mo accent="false" stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mo minsize="1.2em" maxsize="1.2em">(</mo><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>n</mi></msqrt><mo>−</mo><mi>n</mi><mo minsize="1.2em" maxsize="1.2em">)</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mfrac><mrow><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>n</mi></msqrt><mo>+</mo><mi>n</mi></mrow><mrow><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>n</mi></msqrt><mo>+</mo><mi>n</mi></mrow></mfrac><mo data-mjx-texclass="CLOSE">)</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mo stretchy="false">(</mo><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>n</mi><mo stretchy="false">)</mo><mo>−</mo><msup><mi>n</mi><mn>2</mn></msup></mrow><mrow><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>n</mi></msqrt><mo>+</mo><mi>n</mi></mrow></mfrac></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mn>5</mn><mi>n</mi></mrow><mrow><msqrt><msup><mi>n</mi><mn>2</mn></msup><mo>+</mo><mn>5</mn><mi>n</mi></msqrt><mo>+</mo><mi>n</mi></mrow></mfrac></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mn>5</mn><mo>⋅</mo><mi>n</mi></mrow><mrow><msqrt><msup><mi>n</mi><mn>2</mn></msup></msqrt><msqrt><mn>1</mn><mo>+</mo><mfrac><mn>5</mn><mi>n</mi></mfrac></msqrt><mo>+</mo><mi>n</mi></mrow></mfrac></mrow></mtd></mtr></mtable></math>
<math><mrow><mi>n</mi><mo>&gt;</mo><mn>0</mn><mtext>,</mtext></mrow></math>
<math><mrow><msqrt><msup><mi>n</mi><mn>2</mn></msup></msqrt><mo>=</mo><mi>n</mi><mtext>.</mtext></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mrow><mn>5</mn><mo>⋅</mo><mi>n</mi></mrow><mrow><mi>n</mi><msqrt><mn>1</mn><mo>+</mo><mfrac><mn>5</mn><mi>n</mi></mfrac></msqrt><mo>+</mo><mi>n</mi></mrow></mfrac></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>n</mi><mo stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mfrac><mn>5</mn><mrow><msqrt><mn>1</mn><mo>+</mo><mfrac><mn>5</mn><mi>n</mi></mfrac></msqrt><mo>+</mo><mn>1</mn></mrow></mfrac></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>5</mn><mrow><msqrt><mn>1</mn><mo>+</mo><mn>0</mn></msqrt><mo>+</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mfrac><mn>5</mn><mn>2</mn></mfrac></mrow></mtd></mtr></mtable></math>
<math><mrow><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>a</mi><mo accent="false" stretchy="false">→</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><mfrac><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>−</mo><mfrac><mn>1</mn><mi>a</mi></mfrac></mrow><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mi mathvariant="normal">∞</mi><mtext>.</mtext></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>a</mi><mo accent="false" stretchy="false">→</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><mfrac><mn>1</mn><mi>a</mi></mfrac><mo>=</mo><mo>+</mo><mi mathvariant="normal">∞</mi></mrow></mtd></mtr><mtr><mtd><mtext>Also,</mtext></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>a</mi><mo accent="false" stretchy="false">→</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><msup><mi>a</mi><mn>2</mn></msup><mo>=</mo><mn>0</mn></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>a</mi><mo accent="false" stretchy="false">→</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><msup><mi>a</mi><mn>2</mn></msup><mo>−</mo><mfrac><mn>1</mn><mi>a</mi></mfrac><mo>=</mo><mo>−</mo><mi mathvariant="normal">∞</mi></mrow></mtd></mtr><mtr><mtd><mtext>Furthermore,</mtext></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>a</mi><mo accent="false" stretchy="false">→</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><mi>a</mi><mo>−</mo><mn>1</mn><mo>=</mo><mo>−</mo><mn>1</mn></mrow></mtd></mtr><mtr><mtd><mtext>So, using our theorem,</mtext></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>a</mi><mo accent="false" stretchy="false">→</mo><msup><mn>0</mn><mo>+</mo></msup></mrow></munder><mfrac><mrow><msup><mi>a</mi><mn>2</mn></msup><mo>−</mo><mfrac><mn>1</mn><mi>a</mi></mfrac></mrow><mrow><mi>a</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>=</mo><mi mathvariant="normal">∞</mi></mrow></mtd></mtr></mtable></math>
