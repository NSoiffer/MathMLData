<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mi>A</mi></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mi mathvariant="normal">∞</mi></msubsup><mfrac><mn>8</mn><msup><mi>x</mi><mn>3</mn></msup></mfrac><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>t</mi><mo accent="false" stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mo minsize="2.047em" maxsize="2.047em">(</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mi>t</mi></msubsup><mfrac><mn>8</mn><msup><mi>x</mi><mn>3</mn></msup></mfrac><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo minsize="2.047em" maxsize="2.047em">)</mo><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>t</mi><mo accent="false" stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mo minsize="2.047em" maxsize="2.047em">[</mo><mo>−</mo><mfrac><mn>4</mn><msup><mi>x</mi><mn>2</mn></msup></mfrac><msubsup><mo minsize="2.047em" maxsize="2.047em">]</mo><mn>1</mn><mi>t</mi></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>t</mi><mo accent="false" stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mo minsize="2.047em" maxsize="2.047em">[</mo><mo>−</mo><mfrac><mn>4</mn><msup><mi>t</mi><mn>2</mn></msup></mfrac><mo>+</mo><mfrac><mn>4</mn><msup><mn>1</mn><mn>2</mn></msup></mfrac><mo minsize="2.047em" maxsize="2.047em">]</mo><mo>=</mo><mn>0</mn><mo>+</mo><mn>4</mn></mrow></mtd></mtr></mtable></math>
