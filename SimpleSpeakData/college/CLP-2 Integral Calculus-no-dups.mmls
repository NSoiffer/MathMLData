<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>3</mn><mn>5</mn></msubsup><mfrac><mrow><mn>4</mn><mi>x</mi></mrow><mrow><mo stretchy="false">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mo stretchy="false">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo></mrow></mfrac><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>3</mn><mn>5</mn></msubsup><mo minsize="1.623em" maxsize="1.623em">(</mo><mfrac><mn>1</mn><mrow><mi>x</mi><mo>−</mo><mn>1</mn></mrow></mfrac><mo>+</mo><mfrac><mn>1</mn><mrow><mi>x</mi><mo>+</mo><mn>1</mn></mrow></mfrac><mo>−</mo><mfrac><mrow><mn>2</mn><mi>x</mi></mrow><mrow><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn></mrow></mfrac><mo minsize="1.623em" maxsize="1.623em">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.5in"></mspace><mo>=</mo><mo minsize="1.623em" maxsize="1.623em">[</mo><mi>log</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">|</mo><mi>x</mi><mo>−</mo><mn>1</mn><mo stretchy="false">|</mo><mo>+</mo><mi>log</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">|</mo><mi>x</mi><mo>+</mo><mn>1</mn><mo stretchy="false">|</mo><mo>−</mo><mi>log</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>+</mo><mn>1</mn><mo stretchy="false">)</mo><msubsup><mo minsize="1.623em" maxsize="1.623em">]</mo><mn>3</mn><mn>5</mn></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mspace width="0.5in"></mspace><mo>=</mo><mi>log</mi><mo data-mjx-texclass="NONE">⁡</mo><mn>4</mn><mo>+</mo><mi>log</mi><mo data-mjx-texclass="NONE">⁡</mo><mn>6</mn><mo>−