<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><mo data-mjx-texclass="OP">∫</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfrac><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo data-mjx-texclass="OP">∫</mo><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>sin</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></mrow></mfrac><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi mathvariant="normal">d</mi><mi>θ</mi><mspace width="2em"></mspace><mtext>using </mtext><mi>x</mi><mo>=</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>,</mo><mi mathvariant="normal">d</mi><mi>x</mi><mo>=</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi mathvariant="normal">d</mi><mi>θ</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo data-mjx-texclass="OP">∫</mo><mfrac><mrow><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></mrow><mrow><msup><mi>cos</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi></mrow></mfrac><mi mathvariant="normal">d</mi><mi>θ</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mo data-mjx-texclass="OP">∫</mo><mi>sec</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mi mathvariant="normal">d</mi><mi>θ</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>log</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">|</mo><mi>sec</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo>+</mo><mi>tan</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>θ</mi><mo stretchy="false">|</mo><mo>+</mo><mi>C</mi><mspace width="2em"></mspace><mspace width="2em"></mspace><mspace width="2em"></mspace><mtext>Example </mtext><mtext>1.8.19</mtext></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>log</mi><mo data-mjx-texclass="NONE">⁡</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">|</mo><mfrac><mn>1</mn><msqrt><mn>1</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></msqrt></mfrac><mo>+</mo><mfrac><mi>x</mi><msqrt><mn>1</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></msqrt></mfrac><mo data-mjx-texclass="CLOSE">|</mo></mrow><mo>+</mo><mi>C</mi><mspace width="2em"></mspace><mtext>using the triangle below</mtext></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mi>log</mi><mo data-mjx-texclass="NONE">⁡</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">|</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><msqrt><mn>1</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></msqrt></mfrac><mo data-mjx-texclass="CLOSE">|</mo></mrow><mo>+</mo><mi>C</mi></mrow></mtd></mtr></mtable></math>
<math><mrow><mi>log</mi><mo data-mjx-texclass="NONE">⁡</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">|</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><msqrt><mn>1</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></msqrt></mfrac><mo data-mjx-texclass="CLOSE">|</mo></mrow><mtext>.</mtext></mrow></math>
<math><mrow><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>2</mn><mn>3</mn></msubsup><mfrac><mn>1</mn><mrow><mn>1</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></mrow></mfrac><mi mathvariant="normal">d</mi><mi>x</mi><mo>=</mo><msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mi>log</mi><mo data-mjx-texclass="NONE">⁡</mo><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">|</mo><mfrac><mrow><mn>1</mn><mo>+</mo><mi>x</mi></mrow><msqrt><mn>1</mn><mo>−</mo><msup><mi>x</mi><mn>2</mn></msup></msqrt></mfrac><mo data-mjx-texclass="CLOSE">|</mo></mrow><mo data-mjx-texclass="CLOSE">]</mo></mrow><mrow data-mjx-texclass="ORD"><mi>x</mi><mo>=</mo><mn>2</mn></mrow><mrow data-mjx-texclass="ORD"><mi>x</mi><mo>=</mo><mn>3</mn></mrow></msubsup></mrow></math>
