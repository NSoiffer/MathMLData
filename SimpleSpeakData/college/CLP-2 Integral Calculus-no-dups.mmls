<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mover><mi>y</mi><mo stretchy="false">¯</mo></mover></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mi>A</mi></mrow></mfrac><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mi mathvariant="normal">∞</mi></msubsup><mo minsize="1.2em" maxsize="1.2em">[</mo><mi>T</mi><mo stretchy="false">(</mo><mi>x</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo>−</mo><mi>B</mi><mo stretchy="false">(</mo><mi>x</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo minsize="1.2em" maxsize="1.2em">]</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>8</mn></mfrac><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mi mathvariant="normal">∞</mi></msubsup><mo minsize="2.047em" maxsize="2.047em">(</mo><mfrac><mn>8</mn><msup><mi>x</mi><mn>3</mn></msup></mfrac><msup><mo minsize="2.047em" maxsize="2.047em">)</mo><mn>2</mn></msup><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>t</mi><mo accent="false" stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mrow></munder><mo minsize="2.047em" maxsize="2.047em">(</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mi>t</mi></msubsup><mfrac><mn>8</mn><msup><mi>x</mi><mn>6</mn></msup></mfrac><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo minsize="2.047em" maxsize="2.047em">)</mo></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><munder><mo data-mjx-texclass="OP" movablelimits="true">lim</mo><mrow data-mjx-texclass="ORD"><mi>t</mi><mo accent="false" stretchy="false">→</mo><mi mathvariant="normal">∞</mi></mro