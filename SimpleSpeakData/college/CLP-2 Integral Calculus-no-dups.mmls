<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mrow><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>4</mn></mrow></msubsup><msup><mi>sec</mi><mn>4</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>x</mi><msup><mi>tan</mi><mn>5</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>x</mi><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>4</mn></mrow></msubsup><msup><mi>sec</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>x</mi><msup><mi>tan</mi><mn>5</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>x</mi><msup><mi>sec</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>x</mi><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>4</mn></mrow></msubsup><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msup><mi>tan</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>x</mi><mo stretchy="false">)</mo><msup><mi>tan</mi><mn>5</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>x</mi><munder><munder><mrow><msup><mi>sec</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>x</mi><mi mathvariant="normal">d</mi><mi>x</mi></mrow><mo>⏟</mo></munder><mrow data-mjx-texclass="ORD"><mi mathvariant="normal">d</mi><mi>u</mi></mrow></munder></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mrow data-mjx-texclass="ORD"><mi>tan</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mn>0</mn><mo stretchy="false">)</mo></mrow><mrow data-mjx-texclass="ORD"><mi>tan</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mi>π</mi><mo>/</mo><mn>4</mn><mo stretchy="false">)</mo></mrow></msubsup><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><msup><mi>u</mi><mn>2</mn></msup><mo stretchy="false">)</mo><msup><mi>u</mi><mn>5</mn></msup><mi mathvariant="normal">d</mi><mi>u</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mo stretchy="false">(</mo><msup><mi>u</mi><mn>5</mn></msup><mo>+</mo><msup><mi>u</mi><mn>7</mn></msup><mo stretchy="false">)</mo><mi mathvariant="normal">d</mi><mi>u</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mfrac><mn>1</mn><mn>6</mn></mfrac><msup><mi>u</mi><mn>6</mn></msup><mo>+</mo><mfrac><mn>1</mn><mn>8</mn></mfrac><msup><mi>u</mi><mn>8</mn></msup><mo data-mjx-texclass="CLOSE">]</mo></mrow><mn>0</mn><mn>1</mn></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>6</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>8</mn></mfrac><mo>−</mo><mn>0</mn><mo>=</mo><mfrac><mn>7</mn><mn>24</mn></mfrac></mrow></mtd></mtr></mtable></math>
