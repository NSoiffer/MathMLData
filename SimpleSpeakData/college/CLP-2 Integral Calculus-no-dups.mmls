<math><mrow><mi mathvariant="normal">d</mi><mi>v</mi><mo>=</mo><msup><mi>e</mi><mi>x</mi></msup><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mtext>;</mtext></mrow></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mn>5</mn><mo>/</mo><mn>2</mn></mrow></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mi>x</mi><msup><mi>e</mi><mi>x</mi></msup><mo data-mjx-texclass="CLOSE">]</mo></mrow><mn>0</mn><mn>2</mn></msubsup><mo>−</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>2</mn></msubsup><msup><mi>e</mi><mi>x</mi></msup><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>−</mo><mn>3</mn><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mn>2</mn></msubsup><mo stretchy="false">(</mo><msup><mi>x</mi><mn>2</mn></msup><mo>−</mo><mi>x</mi><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo data-mjx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mn>5</mn><mo>/</mo><mn>2</mn></mrow></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mi>x</mi><msup><mi>e</mi><mi>x</mi></msup><mo>−</mo><msup><mi>e</mi><mi>x</mi></msup><mo data-mjx-texclass="CLOSE">]</mo></mrow><mn>0</mn><mn>2</mn></msubsup><mo>−</mo><mn>3</mn><msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><msup><mi>x</mi><mn>3</mn></msup><mo>−</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><msup><mi>x</mi><mn>2</mn></msup><mo data-mjx-texclass="CLOSE">]</mo></mrow><mn>1</mn><mn>2</mn></msubsup><mo data-mjx-texclass="CLOSE">)</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mn>5</mn><mo>/</mo><mn>2</mn></mrow></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mo stretchy="false">(</mo><mn>2</mn><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><msup><mi>e</mi><mn>2</mn></msup><mo stretchy="false">)</mo><mo>−</mo><mo stretchy="false">(</mo><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mo>−</mo><mn>3</mn><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mfrac><mn>8</mn><mn>3</mn></mfrac><mo>−</mo><mn>2</mn><mo>−</mo><mfrac><mn>1</mn><mn>3</mn></mfrac><mo>+</mo><mfrac><mn>1</mn><mn>2</mn></mfrac><mo data-mjx-texclass="CLOSE">)</mo></mrow><mo data-mjx-texclass="CLOSE">)</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mrow><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mn>3</mn><mo>/</mo><mn>2</mn></mrow><mrow><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mn>5</mn><mo>/</mo><mn>2</mn></mrow></mfrac><mo>≈</mo><mn>1.2</mn></mrow></mtd></mtr></mtable></math>
<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mover><mi>y</mi><mo stretchy="false">¯</mo></mover></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mrow><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>2</mn></msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><mi>T</mi><mo stretchy="false">(</mo><mi>x</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo>−</mo><mi>B</mi><mo stretchy="false">(</mo><mi>x</mi><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo data-mjx-texclass="CLOSE">)</mo></mrow><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi></mrow><mrow><mn>2</mn><mi>A</mi></mrow></mfrac></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mrow><mn>2</mn><mo stretchy="false">(</mo><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mn>5</mn><mo>/</mo><mn>2</mn><mo stretchy="false">)</mo></mrow></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>x</mi></mrow></msup><mo>−</mo><mn>0</mn><mo data-mjx-texclass="CLOSE">)</mo></mrow><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>+</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mn>2</mn></msubsup><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><msup><mi>e</mi><mrow data-mjx-texclass="ORD"><mn>2</mn><mi>x</mi></mrow></msup><mo>−</mo><mn>9</mn><mo stretchy="false">(</mo><mi>x</mi><mo>−</mo><mn>1</mn><msup><mo stretchy="false">)</mo><mn>2</mn></msup><mo data-mjx-texclass="CLOSE">)</mo></mrow><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo data-mjx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=