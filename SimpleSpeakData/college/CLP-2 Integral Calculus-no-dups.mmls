<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd><mover><mi>x</mi><mo stretchy="false">¯</mo></mover></mtd><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mrow><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>2</mn></msubsup><mi>x</mi><mo stretchy="false">(</mo><mi>T</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo>−</mo><mi>B</mi><mo stretchy="false">(</mo><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi></mrow><mi>A</mi></mfrac></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mn>5</mn><mo>/</mo><mn>2</mn></mrow></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>1</mn></msubsup><mi>x</mi><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><msup><mi>e</mi><mi>x</mi></msup><mo>−</mo><mn>0</mn><mo data-mjx-texclass="CLOSE">)</mo></mrow><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo>+</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>1</mn><mn>2</mn></msubsup><mi>x</mi><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">(</mo><msup><mi>e</mi><mi>x</mi></msup><mo>−</mo><mn>3</mn><mo stretchy="false">(</mo><mi>x</mi><mo>−</mo><mn>1</mn><mo stretchy="false">)</mo><mo data-mjx-texclass="CLOSE">)</mo></mrow><mspace width="0.167em"></mspace><mi mathvariant="normal">d</mi><mi>x</mi><mo data-mjx-texclass="CLOSE">]</mo></mrow></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mrow><msup><mi>e</mi><mn>2</mn></msup><mo>−</mo><mn>5</mn><mo>/</mo><mn>2</mn></mrow></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mn>2</mn></msubsup><mi>x</mi><msup><mi>e