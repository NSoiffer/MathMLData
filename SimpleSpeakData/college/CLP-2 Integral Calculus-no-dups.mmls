<math><mrow><mo stretchy="false">|</mo><mi>a</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>u</mi><mo stretchy="false">|</mo><mo>≠</mo><mi>a</mi><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>u</mi><mtext>?</mtext></mrow></math>
