<math><mrow><msqrt><msup><mi>a</mi><mn>2</mn></msup><mo>+</mo><msup><mi>x</mi><mn>2</mn></msup></msqrt><mo>=</mo><msqrt><msup><mi>a</mi><mn>2</mn></msup><msup><mi>sec</mi><mn>2</mn></msup><mo data-mjx-texclass="NONE">⁡</mo><mi>u</mi></msqrt><mo>=</mo><mo stretchy="false">|</mo><mi>a</mi><mi>sec</mi><mo data-mjx-texclass="NONE">⁡</mo><mi>u</mi><mo stretchy="false">|</mo></mrow></math>
