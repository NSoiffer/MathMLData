<math><mtable displaystyle="true" columnalign="right left" columnspacing="0em" rowspacing="3pt" minlabelspacing=".8em"><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mo minsize="1.623em" maxsize="1.623em">[</mo><mi>x</mi><mo>−</mo><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mn>2</mn><mi>x</mi><mo stretchy="false">)</mo><msubsup><mo minsize="1.623em" maxsize="1.623em">]</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>3</mn></mrow></msubsup><mo>+</mo><mfrac><mn>1</mn><mn>8</mn></mfrac><msubsup><mo data-mjx-texclass="OP">∫</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>3</mn></mrow></msubsup><mo stretchy="false">(</mo><mn>1</mn><mo>+</mo><mi>cos</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mn>4</mn><mi>x</mi><mo stretchy="false">)</mo><mo stretchy="false">)</mo><mi mathvariant="normal">d</mi><mi>x</mi></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mfrac><mi>π</mi><mn>3</mn></mfrac><mo>−</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac><mo data-mjx-texclass="CLOSE">]</mo></mrow><mo>+</mo><mfrac><mn>1</mn><mn>8</mn></mfrac><mo minsize="1.623em" maxsize="1.623em">[</mo><mi>x</mi><mo>+</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mi>sin</mi><mo data-mjx-texclass="NONE">⁡</mo><mo stretchy="false">(</mo><mn>4</mn><mi>x</mi><mo stretchy="false">)</mo><msubsup><mo minsize="1.623em" maxsize="1.623em">]</mo><mn>0</mn><mrow data-mjx-texclass="ORD"><mi>π</mi><mo>/</mo><mn>3</mn></mrow></msubsup></mrow></mtd></mtr><mtr><mtd/><mtd><mrow><mi>&lt;mi/&gt;</mi><mo>=</mo><mfrac><mn>1</mn><mn>4</mn></mfrac><mrow data-mjx-texclass="INNER"><mo data-mjx-texclass="OPEN">[</mo><mfrac><mi>π</mi><mn>3</mn></mfrac><mo>−</mo><mfrac><msqrt><mn>3</mn></msqrt><mn>2</mn></mfrac><mo data-mjx-texclass="CLOSE">]</mo></mrow><mo>+</mo><mfrac><mn>1</