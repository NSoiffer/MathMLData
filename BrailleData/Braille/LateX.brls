\~ & y_{xx} =\frac{\partial^2 y}{ \partial x^2} =(\frac{\partial}{ \partial \xi} +\frac{\partial}{ \partial \eta})(\frac{ \partial y}{ \partial \xi} +\frac{ \partial y}{ \partial \eta}) =\frac{\partial^2 y}{ \partial \xi^2} +2\frac{\partial^2 y}{ \partial \xi \partial \eta} +\frac{\partial^2 y}{ \partial \eta^2}, \\ \~ & y_{tt} =\frac{\partial^2 y}{ \partial t^2} =( -a\frac{\partial}{ \partial \xi} +a\frac{\partial}{ \partial \eta})( -a\frac{ \partial y}{ \partial \xi} +a\frac{ \partial y}{ \partial \eta}) =a^2 \frac{\partial^2 y}{ \partial \xi^2} -2a^2 \frac{\partial^2 y}{ \partial \xi \partial \eta} +a^2 \frac{\partial^2 y}{ \partial \eta^2} .
