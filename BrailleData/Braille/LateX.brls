E(X)𝐖&𝐖\lt𝐖mi/>𝐖=\sum𝐖_{x𝐖=0}^n𝐖x𝐖\cdot𝐖p(x)𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\sum𝐖_{x𝐖=1}^n𝐖x𝐖\cdot𝐖p(x)𝐖&𝐖since\space𝐖the\~x𝐖=0\~term\space𝐖is\~0𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\sum𝐖_{x𝐖=1}^n𝐖x\binom{n}{x}p^x𝐖(1𝐖-p)^{n𝐖-x}𝐖𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\sum𝐖_{x𝐖=1}^n𝐖x\frac{n!}{(n𝐖-x)!x!}p^x𝐖(1𝐖-p)^{n𝐖-x}𝐖𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\sum𝐖_{x𝐖=1}^n𝐖\frac{n!}{(n𝐖-x)!(x𝐖-1)!}p^x𝐖(1𝐖-p)^{n𝐖-x}𝐖𝐖&𝐖cancelling\space𝐖an\~x𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=np\sum𝐖_{x𝐖=1}^n𝐖\frac{(n𝐖-1)!}{(n𝐖-x)!(x𝐖-1)!}p^{x𝐖-1}𝐖(1𝐖-p)^{n𝐖-x}𝐖𝐖&𝐖\~pull\space𝐖out\~n\~from\~n!\~and\space𝐖one\~p𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=np\sum𝐖_{x𝐖=1}^n𝐖\binom{n𝐖-1}{x𝐖-1}p^{x𝐖-1}𝐖(1𝐖-p)^{(n𝐖-1)𝐖-(x𝐖-1)}𝐖
