\~𝐖\\𝐖\sin𝐖\alpha𝐖𝐖+\sin𝐖\beta𝐖𝐖=2\sin𝐖(\frac{\alpha𝐖𝐖+\beta𝐖}{2})\cos𝐖(\frac{\alpha𝐖𝐖-\beta𝐖}{2})𝐖\\𝐖\sin𝐖\alpha𝐖𝐖-\sin𝐖\beta𝐖𝐖=2\sin𝐖(\frac{\alpha𝐖𝐖-\beta𝐖}{2})\cos𝐖(\frac{\alpha𝐖𝐖+\beta𝐖}{2})𝐖\\𝐖\cos𝐖\alpha𝐖𝐖-\cos𝐖\beta𝐖𝐖=𝐖-2\sin𝐖(\frac{\alpha𝐖𝐖+\beta𝐖}{2})\sin𝐖(\frac{\alpha𝐖𝐖-\beta𝐖}{2})𝐖\\𝐖\cos𝐖\alpha𝐖𝐖+\cos𝐖\beta𝐖𝐖=2\cos𝐖(\frac{\alpha𝐖𝐖+\beta𝐖}{2})\cos𝐖(\frac{\alpha𝐖𝐖-\beta𝐖}{2})
