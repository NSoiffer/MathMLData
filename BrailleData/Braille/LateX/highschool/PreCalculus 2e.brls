\cos𝐖(\alpha𝐖𝐖+\beta𝐖)𝐖=\cos𝐖\alpha𝐖\cos𝐖\beta𝐖𝐖-\sin𝐖\alpha𝐖\sin𝐖\beta𝐖𝐖\\𝐖\cos𝐖(\alpha𝐖𝐖-\beta𝐖)𝐖=\cos𝐖\alpha𝐖\cos𝐖\beta𝐖𝐖+\sin𝐖\alpha𝐖\sin𝐖\beta𝐖𝐖\\𝐖\sin𝐖(\alpha𝐖𝐖+\beta𝐖)𝐖=\sin𝐖\alpha𝐖\cos𝐖\beta𝐖𝐖+\cos𝐖\alpha𝐖\sin𝐖\beta𝐖𝐖\\𝐖\sin𝐖(\alpha𝐖𝐖-\beta𝐖)𝐖=\sin𝐖\alpha𝐖\cos𝐖\beta𝐖𝐖-\cos𝐖\alpha𝐖\sin𝐖\beta𝐖𝐖\\𝐖\tan𝐖(\alpha𝐖𝐖+\beta𝐖)𝐖=\frac{\tan𝐖\alpha𝐖𝐖+\tan𝐖\beta𝐖}{1𝐖-\tan𝐖\alpha𝐖\tan𝐖\beta𝐖}𝐖\\𝐖\tan𝐖(\alpha𝐖𝐖-\beta𝐖)𝐖=\frac{\tan𝐖\alpha𝐖𝐖-\tan𝐖\beta𝐖}{1𝐖+\tan𝐖\alpha𝐖\tan𝐖\beta𝐖}
\sin𝐖(2\theta𝐖)𝐖=2\sin𝐖\theta𝐖\cos𝐖\theta𝐖𝐖\\𝐖\cos𝐖(2\theta𝐖)𝐖=\cos𝐖^2𝐖\theta𝐖𝐖-\sin𝐖^2𝐖\theta𝐖𝐖\\𝐖\cos𝐖(2\theta𝐖)𝐖=1𝐖-2\sin𝐖^2𝐖\theta𝐖𝐖\\𝐖\cos𝐖(2\theta𝐖)𝐖=2\cos𝐖^2𝐖\theta𝐖𝐖-1𝐖\\𝐖\tan𝐖(2\theta𝐖)𝐖=\frac{2\tan𝐖\theta𝐖}{1𝐖-\tan𝐖^2𝐖\theta𝐖}
\sin𝐖\frac{\alpha𝐖}{2}𝐖=𝐖\pm𝐖\sqrt{\frac{1𝐖-\cos𝐖\alpha𝐖}{2}}𝐖\\𝐖\cos𝐖\frac{\alpha𝐖}{2}𝐖=𝐖\pm𝐖\sqrt{\frac{1𝐖+\cos𝐖\alpha𝐖}{2}}𝐖\\𝐖\tan𝐖\frac{\alpha𝐖}{2}𝐖=𝐖\pm𝐖\sqrt{\frac{1𝐖-\cos𝐖\alpha𝐖}{1𝐖+\cos𝐖\alpha𝐖}}𝐖\\𝐖\tan𝐖\frac{\alpha𝐖}{2}𝐖=\frac{\sin𝐖\alpha𝐖}{1𝐖+\cos𝐖\alpha𝐖}𝐖\\𝐖\tan𝐖\frac{\alpha𝐖}{2}𝐖=\frac{1𝐖-\cos𝐖\alpha𝐖}{\sin𝐖\alpha𝐖}
\sin𝐖^2𝐖\theta𝐖𝐖=\frac{1𝐖-\cos𝐖(2\theta𝐖)}{2}𝐖\\𝐖\cos𝐖^2𝐖\theta𝐖𝐖=\frac{1𝐖+\cos𝐖(2\theta𝐖)}{2}𝐖\\𝐖\tan𝐖^2𝐖\theta𝐖𝐖=\frac{1𝐖-\cos𝐖(2\theta𝐖)}{1𝐖+\cos𝐖(2\theta𝐖)}
\cos𝐖\alpha𝐖\cos𝐖\beta𝐖𝐖=\frac{1}{2}[\cos𝐖(\alpha𝐖𝐖-\beta𝐖)𝐖+\cos𝐖(\alpha𝐖𝐖+\beta𝐖)]𝐖\\𝐖\sin𝐖\alpha𝐖\cos𝐖\beta𝐖𝐖=\frac{1}{2}[\sin𝐖(\alpha𝐖𝐖+\beta𝐖)𝐖+\sin𝐖(\alpha𝐖𝐖-\beta𝐖)]𝐖\\𝐖\sin𝐖\alpha𝐖\sin𝐖\beta𝐖𝐖=\frac{1}{2}[\cos𝐖(\alpha𝐖𝐖-\beta𝐖)𝐖-\cos𝐖(\alpha𝐖𝐖+\beta𝐖)]𝐖\\𝐖\cos𝐖\alpha𝐖\sin𝐖\beta𝐖𝐖=\frac{1}{2}[\sin𝐖(\alpha𝐖𝐖+\beta𝐖)𝐖-\sin𝐖(\alpha𝐖𝐖-\beta𝐖)]
\sin𝐖\alpha𝐖𝐖+\sin𝐖\beta𝐖𝐖=2\sin𝐖(\frac{\alpha𝐖𝐖+\beta𝐖}{2})\cos𝐖(\frac{\alpha𝐖𝐖-\beta𝐖}{2})𝐖\\𝐖\sin𝐖\alpha𝐖𝐖-\sin𝐖\beta𝐖𝐖=2\sin𝐖(\frac{\alpha𝐖𝐖-\beta𝐖}{2})\cos𝐖(\frac{\alpha𝐖𝐖+\beta𝐖}{2})𝐖\\𝐖\cos𝐖\alpha𝐖𝐖-\cos𝐖\beta𝐖𝐖=𝐖-2\sin𝐖(\frac{\alpha𝐖𝐖+\beta𝐖}{2})\sin𝐖(\frac{\alpha𝐖𝐖-\beta𝐖}{2})𝐖\\𝐖\cos𝐖\alpha𝐖𝐖+\cos𝐖\beta𝐖𝐖=2\cos𝐖(\frac{\alpha𝐖𝐖+\beta𝐖}{2})\cos𝐖(\frac{\alpha𝐖𝐖-\beta𝐖}{2})
\frac{\sin𝐖\alpha𝐖}{a}𝐖=\frac{\sin𝐖\beta𝐖}{b}𝐖=\frac{\sin𝐖\gamma𝐖}{c}𝐖\\𝐖\frac{a}{\sin𝐖\alpha𝐖}𝐖=\frac{b}{\sin𝐖\beta𝐖}𝐖=\frac{c}{\sin𝐖\gamma𝐖}
