\frac{\partial^2 u}{ \partial x^2}(x, t) & \lt mi/> =\frac{\partial}{ \partial x}[\frac{ \partial v}{ \partial \xi}(\xi (x, t), \eta (x, t))] +\frac{\partial}{ \partial x}[\frac{ \partial v}{ \partial \eta}(\xi (x, t), \eta (x, t))] \\ \~ & \lt mi/> =\frac{\partial^2 v}{ \partial \xi^2}(\xi (x, t), \eta (x, t))\frac{ \partial \xi}{ \partial x} +\frac{\partial^2 v}{ \partial \eta \partial \xi}(\xi (x, t), \eta (x, t))\frac{ \partial \eta}{ \partial x} \\ \~ & \lt mi/> +\frac{\partial^2 v}{ \partial \xi \partial \eta}(\xi (x, t), \eta (x, t))\frac{ \partial \xi}{ \partial x} +\frac{\partial^2 v}{ \partial \eta^2}(\xi (x, t), \eta (x, t))\frac{ \partial \eta}{ \partial x} \\ \~ & \lt mi/> =\frac{\partial^2 v}{ \partial \xi^2}(\xi (x, t), \eta (x, t)) +2\frac{\partial^2 v}{ \partial \xi \partial \eta}(\xi (x, t), \eta (x, t)) \\ \~ & \lt mi/> +\frac{\partial^2 v}{ \partial \eta^2}(\xi (x, t), \eta (x, t))
