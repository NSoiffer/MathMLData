(a)𝐖&𝐖\iint𝐖_R𝐖(x^2𝐖𝐖+y^2𝐖)dxdy𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^a𝐖dx\int𝐖_0^b𝐖dy(x^2𝐖𝐖+y^2𝐖)𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^a𝐖dx(x^2𝐖b𝐖+\frac{1}{3}b^3𝐖)𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{1}{3}(a^3𝐖b𝐖+ab^3𝐖)𝐖\\𝐖(b)𝐖&𝐖\iint𝐖_T𝐖(x𝐖-3y)dxdy𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^a𝐖dx\int𝐖_0^{b(1𝐖-\frac{x}{a})}𝐖dy(x𝐖-3y)𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^a𝐖dx[bx(1𝐖-\frac{x}{a})𝐖-\frac{3}{2}b^2𝐖(1𝐖-\frac{x}{a})^2𝐖]𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=[\frac{b}{2}x^2𝐖𝐖-\frac{b}{3a}x^3𝐖𝐖+\frac{a}{2}b^2𝐖(1𝐖-\frac{x}{a})^3𝐖]_0^a𝐖𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{a^2𝐖b}{2}𝐖-\frac{a^2𝐖b}{3}𝐖-\frac{ab^2𝐖}{2}𝐖=\frac{a^2𝐖b}{6}𝐖-\frac{ab^2𝐖}{2}𝐖\\𝐖(c)𝐖&𝐖\iint𝐖_R𝐖xy^2𝐖dxdy𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^1𝐖dx\int𝐖_{x^2𝐖}^{\sqrt{x}}𝐖dyxy^2𝐖𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{1}{3}\int𝐖_0^1𝐖dxx(x^{3/2}𝐖𝐖-x^6𝐖)𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{1}{3}(\frac{2}{7}𝐖-\frac{1}{8})𝐖=\frac{3}{56}𝐖\\𝐖(d)𝐖&𝐖\iint𝐖_D𝐖x\cos𝐖ydxdy𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^1𝐖dx\int𝐖_0^{1𝐖-x^2𝐖}𝐖dyx\cos𝐖y𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^1𝐖dxx\sin𝐖(1𝐖-x^2𝐖)𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{1}{2}[\cos𝐖(1𝐖-x^2𝐖)]_0^1𝐖𝐖=\frac{1}{2}(1𝐖-\cos𝐖1)𝐖\\𝐖(e)𝐖&𝐖\iint𝐖_R𝐖\frac{x}{y}e^y𝐖dxdy𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^1𝐖dy\int𝐖_y^{\sqrt{y}}𝐖dx\frac{x}{y}e^y𝐖𝐖=\int𝐖_0^1𝐖dy\frac{y𝐖-y^2𝐖}{2y}e^y𝐖𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{1}{2}\int𝐖_0^1𝐖dy(1𝐖-y)e^y𝐖𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{1}{2}[𝐖-ye^y𝐖𝐖+2e^y𝐖]_0^1𝐖𝐖=\frac{1}{2}(e𝐖-2)𝐖\\𝐖(f)𝐖&𝐖\iint𝐖_T𝐖\frac{xy}{1𝐖+x^4𝐖}dxdy𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^1𝐖dx\int𝐖_x^1𝐖dy\frac{xy}{1𝐖+x^4𝐖}𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{1}{2}\int𝐖_0^1𝐖dx\frac{x(1𝐖-x^2𝐖)}{1𝐖+x^4𝐖}𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{1}{4}\int𝐖_0^1𝐖dt\frac{1𝐖-t}{1𝐖+t^2𝐖}\~where\~t𝐖=x^2𝐖𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{1}{4}[\arctan𝐖t𝐖-\frac{1}{2}\ln𝐖(1𝐖+t^2𝐖)]_0^1𝐖𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{1}{4}(\frac{\pi𝐖}{4}𝐖-\frac{1}{2}\ln𝐖2)
(a)𝐖&𝐖\int𝐖_0^2𝐖dx\int𝐖_1^{e^x𝐖}𝐖dy𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^2𝐖dx[e^x𝐖𝐖-1]𝐖=[e^x𝐖𝐖-x]_0^2𝐖𝐖=e^2𝐖𝐖-3𝐖\\𝐖\int𝐖_1^{e^2𝐖}𝐖dy\int𝐖_{\ln𝐖y}^2𝐖dx𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_1^{e^2𝐖}𝐖dy[2𝐖-\ln𝐖y]𝐖=[2y𝐖-y\ln𝐖y𝐖+y]_1^{e^2𝐖}𝐖𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=e^2𝐖𝐖-3𝐖\\𝐖(b)𝐖&𝐖\int𝐖_0^{\sqrt{2}}𝐖dy\int𝐖_{𝐖-\sqrt{4𝐖-2y^2𝐖}}^{\sqrt{4𝐖-2y^2𝐖}}𝐖dxy𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^{\sqrt{2}}𝐖dy2y\sqrt{4𝐖-2y^2𝐖}𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=𝐖-\frac{1}{3}[(4𝐖-2y^2𝐖)^{3/2}𝐖]_0^{\sqrt{2}}𝐖𝐖=\frac{8}{3}𝐖\\𝐖\int𝐖_{𝐖-2}^2𝐖dx\int𝐖_0^{\sqrt{2𝐖-\frac{x^2𝐖}{2}}}𝐖dyy𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_{𝐖-2}^2𝐖dx[1𝐖-\frac{x^2𝐖}{4}]𝐖=2\int𝐖_0^2𝐖dx[1𝐖-\frac{x^2𝐖}{4}]𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=2[x𝐖-\frac{x^3𝐖}{12}]_0^2𝐖𝐖=\frac{8}{3}𝐖\\𝐖(c)𝐖&𝐖\int𝐖_{𝐖-2}^1𝐖dx\int𝐖_{x^2𝐖𝐖+4x}^{3x𝐖+2}𝐖dy𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_{𝐖-2}^1𝐖dx[𝐖-x^2𝐖𝐖-x𝐖+2]𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=[𝐖-\frac{x^3𝐖}{3}𝐖-\frac{x^2𝐖}{2}𝐖+2x]_{𝐖-2}^1𝐖𝐖=\frac{9}{2}𝐖\\𝐖\int𝐖_{𝐖-4}^5𝐖dy\int𝐖_{\frac{y𝐖-2}{3}}^{𝐖-2𝐖+\sqrt{4𝐖+y}}𝐖dx𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_{𝐖-4}^5𝐖dy[𝐖-\frac{4}{3}𝐖-\frac{y}{3}𝐖+\sqrt{4𝐖+y}]𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=[𝐖-\frac{4y}{3}𝐖-\frac{y^2𝐖}{6}𝐖+\frac{2}{3}(4𝐖+y)^{\frac{3}{2}}𝐖]_{𝐖-4}^5𝐖𝐖=\frac{9}{2}
