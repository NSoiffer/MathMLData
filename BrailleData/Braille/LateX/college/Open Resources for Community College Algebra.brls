\frac{4x^3𝐖y^2𝐖}{3x^4𝐖}𝐖\cdot𝐖\frac{9x^4𝐖y^2𝐖}{8y^5𝐖}𝐖=
\frac{5yx}{3y}𝐖\cdot𝐖\frac{3y^2𝐖x^3𝐖}{25x^5𝐖}𝐖=
\frac{y^2𝐖𝐖+9yt𝐖+20t^2𝐖}{y𝐖+t}𝐖\cdot𝐖\frac{2y𝐖+2t}{y𝐖+5t}𝐖=
\frac{r^2𝐖𝐖+ry𝐖-12y^2𝐖}{r𝐖+6y}𝐖\cdot𝐖\frac{3r𝐖+18y}{r𝐖-3y}𝐖=
\frac{rx^{10}𝐖}{4}𝐖\div𝐖\frac{rx^5𝐖}{8}𝐖=
