\int𝐖_C𝐖\rho𝐖ds𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^4𝐖t\sqrt{2}(t𝐖+1)dt𝐖=\frac{2^3𝐖𝐖\cdot𝐖11\sqrt{2}}{3}𝐖\\𝐖\int𝐖_C𝐖x\rho𝐖ds𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^4𝐖(t𝐖+\frac{1}{2}t^2𝐖)t\sqrt{2}(t𝐖+1)dt𝐖=\sqrt{2}\int𝐖_0^{2^2𝐖}𝐖(\frac{t^4𝐖}{2}𝐖+\frac{3}{2}t^3𝐖𝐖+t^2𝐖)dt𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\sqrt{2}(\frac{2^9𝐖}{5}𝐖+3(2^5𝐖)𝐖+\frac{2^6𝐖}{3})𝐖=\frac{2^5𝐖𝐖\cdot𝐖103\sqrt{2}}{15}𝐖\\𝐖\int𝐖_C𝐖y\rho𝐖ds𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^4𝐖(t𝐖-\frac{1}{2}t^2𝐖)t\sqrt{2}(t𝐖+1)dt𝐖=\sqrt{2}\int𝐖_0^{2^2𝐖}𝐖(𝐖-\frac{t^4𝐖}{2}𝐖+\frac{t^3𝐖}{2}𝐖+t^2𝐖)dt𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\sqrt{2}(𝐖-\frac{2^9𝐖}{5}𝐖+2^5𝐖𝐖+\frac{2^6𝐖}{3})𝐖=𝐖-\frac{2^5𝐖𝐖\cdot𝐖23\sqrt{2}}{15}𝐖\\𝐖\int𝐖_C𝐖z\rho𝐖ds𝐖&𝐖\lt𝐖mi/>𝐖=\int𝐖_0^4𝐖(\frac{4}{3}t^{3/2}𝐖)t\sqrt{2}(t𝐖+1)dt𝐖=\frac{4\sqrt{2}}{3}\int𝐖_0^{2^2𝐖}𝐖(t^{7/2}𝐖𝐖+t^{5/2}𝐖)dt𝐖\\𝐖\~𝐖&𝐖\lt𝐖mi/>𝐖=\frac{4\sqrt{2}}{3}(\frac{2^{10}𝐖}{9}𝐖+\frac{2^8𝐖}{7})𝐖=\frac{2^{10}𝐖𝐖\cdot𝐖37\sqrt{2}}{7𝐖\cdot𝐖3^3𝐖}𝐖\\𝐖\overline{x}𝐖&𝐖\lt𝐖mi/>𝐖=\frac{𝐖\int𝐖x\rho𝐖ds}{𝐖\int𝐖\rho𝐖ds}𝐖=\frac{\frac{2^5𝐖𝐖\cdot𝐖103\sqrt{2}}{15}}{\frac{2^3𝐖𝐖\cdot𝐖11\sqrt{2}}{3}}𝐖=\frac{412}{55}𝐖\approx𝐖7.5𝐖\\𝐖\overline{y}𝐖&𝐖\lt𝐖mi/>𝐖=\frac{𝐖\int𝐖y\rho𝐖ds}{𝐖\int𝐖\rho𝐖ds}𝐖=\frac{𝐖-\frac{2^5𝐖𝐖\cdot𝐖23\sqrt{2}}{15}}{\frac{2^3𝐖𝐖\cdot𝐖11\sqrt{2}}{3}}𝐖=𝐖-\frac{92}{55}𝐖\approx𝐖𝐖-1.7𝐖\\𝐖\overline{z}𝐖&𝐖\lt𝐖mi/>𝐖=\frac{𝐖\int𝐖z\rho𝐖ds}{𝐖\int𝐖\rho𝐖ds}𝐖=\frac{\frac{2^{10}𝐖𝐖\cdot𝐖37\sqrt{2}}{7𝐖\cdot𝐖3^3𝐖}}{\frac{2^3𝐖𝐖\cdot𝐖11\sqrt{2}}{3}}𝐖=\frac{4736}{693}𝐖\approx𝐖6.8
